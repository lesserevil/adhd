OBJECT_ROOT ?= _build/objects
OUT ?= _build/artifacts
TARGET ?= run.exs
EXPORT_PATH ?= $(OUT)/$(TARGET)
LITAI_LANGUAGE_TOOL ?= elixir
SRCS := main.exs validation.ex domain.ex federation.ex store.ex assets.ex http.ex cli.ex tests/litai_test.exs tools/assemble.exs

.PHONY: all test clean
all: $(SRCS) Makefile
	"$(LITAI_LANGUAGE_TOOL)" tools/assemble.exs all "$(EXPORT_PATH)" "$(OBJECT_ROOT)" "$(OUT)"

test: all
	"$(LITAI_LANGUAGE_TOOL)" "$(EXPORT_PATH)" --litai-test

clean: tools/assemble.exs
	"$(LITAI_LANGUAGE_TOOL)" tools/assemble.exs clean "$(EXPORT_PATH)" "$(OBJECT_ROOT)" "$(OUT)"
