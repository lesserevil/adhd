    assertion=%{"label"=>%{"expectation"=>"supported","tags"=>[]}}
    control=%{"label"=>%{"expectation"=>"supported","tags"=>["correction"]}}
    proof=%{"held_out"=>[assertion],"regression"=>[control]}
    comparison=fn gain->%{"comparison"=>%{"eligible"=>true,"retrieval_gain_ppm"=>gain,"answer_regressions"=>0,"false_supports"=>0,"calls_delta"=>0,"bytes_delta"=>0,"time_ms_delta"=>0},"baseline"=>%{"eligible"=>true,"answer_pass"=>true},"candidate"=>%{"eligible"=>true,"answer_pass"=>true},"group_id"=>Integer.to_string(gain)} end
    mixed=ADHD.OptimizationWorker.evaluation(s,proof,[comparison.(1000000),comparison.(-500000)],c,false)
    equal(mixed["mean_recall_gain_ppm"],250000);equal(mixed["answer_failures"],0);equal(mixed["passed"],false)
    parent=%{"id"=>"native-opt-parent","status"=>"pending","children"=>[%{"replay_id"=>"native-opt-pair","run"=>1}],"base_identity"=>ADHD.Selection.base_identity(c),"selection_revision"=>0,"training"=>[],"held_out"=>[],"regression"=>[],"policy_identity"=>O.policy(c,s)}
