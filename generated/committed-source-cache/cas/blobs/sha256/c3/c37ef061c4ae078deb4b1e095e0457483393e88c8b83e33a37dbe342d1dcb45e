  defp repair(s,c,cmd,actor) do
    if not enabled?(c),do: D.fail("EVENTING_DISABLED")
    key=Integer.to_string(cmd["offset"])
    key=if Map.has_key?(s.eventing.quarantine,key),do: key,else: "invalid-offset"
    item=s.eventing.quarantine[key]
    if not is_map(item) or s.eventing.next_offset != cmd["expected_checkpoint"] or item["digest"] != cmd["expected_digest"],do: D.fail("EVENTING_CONFLICT")
    if (cmd["action"]=="reconcile" and (cmd["offset"] != s.eventing.next_offset or key=="invalid-offset")) or (key=="invalid-offset" and cmd["offset"] != s.eventing.next_offset),do: D.fail("EVENTING_CONFLICT")
    linked=Enum.filter(s.eventing.events,fn {_,row}->row.offset==cmd["offset"] and row.state != :materialized end)
    e=if cmd["action"]=="reconcile" do
      events=Enum.reduce(linked,s.eventing.events,fn {id,row},acc->Map.put(acc,id,row |> Map.put(:state,:pending) |> Map.put(:offset,nil) |> Map.put(:broker_observed,false)) end)
      %{s.eventing|events: events,next_offset: cmd["offset"]+1}
    else s.eventing end
    e=%{e|quarantine: Map.delete(e.quarantine,key),control_revision: e.control_revision+1,last_error: nil}
    {audit_id,next}=audit(%{s|eventing: e},cmd,actor,"repair",%{"missing_logical_proof"=>linked==[]})
    {%{"audit_id"=>audit_id,"control_revision"=>e.control_revision,"next_offset"=>e.next_offset},next}
  end
  defp replay(s,c,cmd,actor) do
    ADHD.Projects.writable(c,"replay_events")
    if not enabled?(c),do: D.fail("EVENTING_DISABLED")
    if cmd["expected_watermark"] != replay_watermark(s),do: D.fail("EVENTING_CONFLICT")
    if cmd["from_sequence"]>cmd["to_sequence"] or cmd["to_sequence"]>replay_watermark(s),do: D.fail("EVENTING_CONFLICT")
    selected=s.publications |> Map.values() |> Enum.filter(&(&1.seq>=cmd["from_sequence"] and &1.seq<=cmd["to_sequence"])) |> Enum.sort_by(& &1.seq)
    if selected==[],do: D.fail("NOT_FOUND")
    if length(selected)>1000,do: D.fail("RANGE_TOO_LARGE")
    {rid,s}=ADHD.Allocator.allocate(s,"eventreplay")
    targets=Enum.map(cmd["subscriptions"],fn target->
      row=s.subscriptions[target["id"]]
      if is_nil(row),do: D.fail("EVENTING_CONFLICT")
      sub=row.value
      if Map.get(sub,"revision",1) != target["revision"] or sub["paused"]==true or sub["status"]=="paused" or not Map.has_key?(c["agents"],sub["agent_id"]),do: D.fail("EVENTING_CONFLICT")
