  @special %{"RecoveryConfig"=>"ProjectRecoveryConfig","RecoveryMergePatch"=>"ProjectRecoveryMergePatch","AdminCommand"=>"ProjectRecoveryCommand","AdminResult"=>"ProjectRecoveryResult"}
  def authority_sha256, do: @authority_sha256
  defp name(value), do: Map.get(@special,value,"ProjectRecovery"<>value)
  defp rename(value) when is_map(value) do
    Map.new(value, fn {key,item}->
      item=if key=="$ref" and is_binary(item) and String.starts_with?(item,"#/$defs/"),do: "#/$defs/"<>name(String.replace_prefix(item,"#/$defs/","")),else: rename(item)
      {key,item}
    end)
  end
  defp rename(value) when is_list(value), do: Enum.map(value,&rename/1)
  defp rename(value), do: value
  def extend(defs) do
    recovery=Map.new(@authority["$defs"],fn {key,value}->{name(key),rename(value)} end)
    defs=Map.merge(defs,recovery)
    ops = ~w(project_restore_plan project_restore_apply project_restore_status)
    request_names = ~w(PlanCommand ApplyCommand StatusCommand)
    defs=Enum.zip(ops,request_names) |> Enum.reduce(defs,fn {op,shape},acc->Map.put(acc,"admin_"<>op,P.ref(name(shape))) end)
    accepted=recovery["ProjectRecoveryAccepted"]
    plan=put_in(accepted,["properties","kind"],%{"const"=>"plan"})
    apply=put_in(accepted,["properties","kind"],%{"const"=>"apply"})
    defs=defs |> Map.put("admin_result_project_restore_plan",plan) |> Map.put("admin_result_project_restore_apply",apply) |> Map.put("admin_result_project_restore_status",P.ref("ProjectRecoveryStatus"))
    defs=Enum.reduce([{"AdminCommand","oneOf","admin_"},{"AdminResult","anyOf","admin_result_"}],defs,fn {key,union,prefix},acc->update_in(acc,[key,union],&Enum.uniq((&1 || [])++Enum.map(ops,fn op->P.ref(prefix<>op) end))) end)
    defs=put_in(defs,["PublicConfig","properties","recovery"],P.ref("ProjectRecoveryConfig"))
    defs=put_in(defs,["MergePatch","properties","recovery"],P.ref("ProjectRecoveryMergePatch"))
    # Preserve every existing error envelope/code while closing the new codes'
    # message and revision-field behavior to the reviewed recovery contract.
    conditions=get_in(recovery,["ProjectRecoveryError","oneOf",Access.at(0),"properties","error","allOf"])
    conditions=Enum.map(conditions,fn condition->put_in(condition,["then","properties","current_revision"],false) end)
    update_in(defs,["Error","properties","error","allOf"],fn old->(old || [])++conditions end)
  end
  def openapi(paths) do
    update_in(paths,["/admin/api","post","responses","503"],fn response->
      Map.put(response,"headers",%{"Retry-After"=>%{"description"=>"One second for recovery/configuration admission; retry identical message ID","schema"=>%{"const"=>"1"}}})
