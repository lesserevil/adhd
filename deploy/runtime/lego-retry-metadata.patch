+package internal
+
+import (
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestACMERetryMetadata(t *testing.T) {
+	now := time.Date(2026, 10, 22, 12, 0, 0, 0, time.UTC)
+	for _, c := range []struct {
+		header string
+		known  bool
+		delta  int64
+	}{
+		{"120", true, 120000}, {"0", true, 0}, {"Thu, 22 Oct 2026 12:02:00 GMT", true, 120000},
+		{"Thu, 22 Oct 2026 11:02:00 GMT", true, 0}, {"", false, 0}, {"bad", false, 0},
+		{"-1", false, 0}, {"+1", false, 0}, {"18446744073709551615", false, 0},
+	} {
+		value := NewACMERetryError(errors.New("private CA detail"), c.header, now, 429)
+		if (value.RetryAt != nil) != c.known {
+			t.Fatalf("header %q known", c.header)
+		}
+		if c.known && *value.RetryAt != now.UnixMilli()+c.delta {
+			t.Fatalf("header %q value", c.header)
+		}
+	}
+}
+
+type ACMEFinal429Transport struct {
+	Calls  int
+	Status int
+	Body   string
+}
+
+func (f *ACMEFinal429Transport) RoundTrip(request *http.Request) (*http.Response, error) {
+	f.Calls++
+	header := "0"
+	if f.Calls == 6 {
+		header = "120"
+	}
+	return &http.Response{StatusCode: f.Status, Header: http.Header{"Retry-After": []string{header}},
+		Body:    io.NopCloser(strings.NewReader(f.Body)),
+		Request: request}, nil
+}
+func TestACMEFinalExhaustedResponsesPreserveLastHeader(t *testing.T) {
+	retryTestPath(t)
+	for _, test := range []struct {
+		status int
+		body   string
+		code   string
+	}{
+		{429, `{"type":"urn:ietf:params:acme:error:rateLimited","status":429,"detail":"private"}`, "ACME_RATE_LIMIT"},
+		{503, `{"type":"urn:ietf:params:acme:error:serverInternal","status":503,"detail":"private"}`, "ACME_PROCESS"},
+		{429, `<html>private</html>`, "ACME_RATE_LIMIT"},
+		{503, `<html>private</html>`, "ACME_PROCESS"},
+	} {
+		transport := &ACMEFinal429Transport{Status: test.status, Body: test.body}
+		client := NewRetryableClient(&http.Client{Transport: transport})
+		before := time.Now().UnixMilli()
+		_, err := client.Get("https://no-network.invalid/directory")
+		var metadata *ACMERetryError
+		if transport.Calls != 6 || !errors.As(err, &metadata) || metadata.RetryAt == nil || metadata.Code != test.code {
+			t.Fatalf("final retry metadata lost for %d", test.status)
+		}
+		if *metadata.RetryAt < before+120000 || *metadata.RetryAt > time.Now().UnixMilli()+120000 {
+			t.Fatal("wrong final delay")
+		}
+	}
+}
