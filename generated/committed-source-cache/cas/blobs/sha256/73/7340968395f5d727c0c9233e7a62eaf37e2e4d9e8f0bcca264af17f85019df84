    cmd=%{"op"=>"publish_record","text"=>"Yes","context"=>%{"question"=>"Was this observed?","subject"=>"native-tree"}}
    {first,s}=ADHD.Store.execute(s,c,"native-a","record-once",cmd)
    id=first["record"]["publication"]["id"]
    {before,s}=ADHD.Store.execute(s,c,"native-a","record-read",%{"op"=>"get_record","publication_id"=>id})
    mark=before["snapshot"]["watermark"]
    {_,s}=ADHD.Store.execute(s,c,"native-a","record-sub",%{"op"=>"subscribe","description"=>"Native observations"})
    equal(ADHD.Records.watermark(s),mark)
    {_,s}=ADHD.Store.execute(s,c,"native-a","record-correct",%{"op"=>"publish_record","text"=>"Actually, uncertain.","context"=>%{"links"=>[%{"relation"=>"corrects","publication_id"=>id}]}})
    {old,_}=ADHD.Store.execute(s,c,"native-a","record-old",%{"op"=>"get_record","publication_id"=>id,"watermark"=>mark})
    equal(old,before)
    {now,_}=ADHD.Store.execute(s,c,"native-a","record-current",%{"op"=>"get_record","publication_id"=>id})
    equal(length(now["related"]),1)
    equal(ADHD.Records.upgrade(s),s)
    rejects(fn->ADHD.Records.context(%{"external"=>[%{"uri"=>"https://source.example","snapshot"=>"x","sha256"=>String.duplicate("0",64)}]}) end)
    rejects(fn->D.agent(%{"op"=>"get_record","publication_id"=>id,"watermark"=>1.0}) end)
  end
