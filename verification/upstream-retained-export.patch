+            )
+
+            cache_root = Path(self.environment["BUILD_DIR"]) / "accepted-source-cache"
+            cache = FileSystemSourceCache("export-fixture", cache_root)
+            entries = cache.published_entries()
+            lock = entries[-1].derivation.component_lock_identity
+            authority = validated_project_authority_identity(self.project)
+            context = {
+                "component_lock_identity": lock,
+                "project_authority_identity": authority,
+                "target": "host",
+            }
+            self.assertEqual(
+                len(current_accepted_source_bindings(cache_root, **context)), 1
+            )
+            for changes in (
+                {"target": "other"},
+                {"project_authority_identity": canonical_identity("stale")},
+                {"component_lock_identity": canonical_identity("stale")},
+            ):
+                self.assertEqual(
+                    current_accepted_source_bindings(
+                        cache_root, **{**context, **changes}
+                    ),
+                    (),
+                )
+
+            # The restored source must still face the CURRENT independent oracle.
+            from literate_ai.adapters.component_acceptance import (
+                FilesystemComponentAcceptanceOracle,
+            )
+            from literate_ai.adapters.lifecycle import LocalIndependentAcceptanceCase
+
+            original = FilesystemComponentAcceptanceOracle.cases
+            observed = []
+
+            def reject_current(oracle, component_lock):
+                cases = original(oracle, component_lock)
+                observed.append(True)
+                first = cases[0]
+                return (
+                    LocalIndependentAcceptanceCase.create(
+                        first.case_id,
+                        json.loads(first.arguments_document),
+                        {"deliberate": "independent refusal"},
+                    ),
+                    *cases[1:],
+                )
+
+            receipt = self.project / "verification/current.json"
+            previous = receipt.read_bytes()
+            with patch.object(
+                FilesystemComponentAcceptanceOracle, "cases", reject_current
+            ):
+                status, refused = self.build()
+            self.assertTrue(observed)
+            self.assertNotEqual(status, 0, refused)
+            self.assertIn("accept", refused["error"]["message"])
+            self.assertEqual(receipt.read_bytes(), previous)
+            self.assertEqual(
+                hashlib.sha256(artifact.read_bytes()).hexdigest(), artifact_digest
+            )
+
+            # Retirement is a membership operation; immutable manifests remain.
+            for entry in cache.published_entries():
+                cache.retire_other_memberships(
+                    entry.derivation.cache_key,
+                    keep=canonical_identity("no-surviving-fixture-membership"),
+                )
+            self.assertTrue(cache.published_entries())
+            self.assertEqual(
+                current_accepted_source_bindings(cache_root, **context), ()
+            )
+            status, missed = self.build()
+            self.assertNotEqual(status, 0, missed)
+            self.assertEqual(missed["error"]["code"], "source_cache.runtime_absent")
