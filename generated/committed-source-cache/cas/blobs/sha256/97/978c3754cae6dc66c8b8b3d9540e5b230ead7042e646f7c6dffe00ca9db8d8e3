  end
  def neighbors(recipe,max_count) do
    alternatives=[Map.put(recipe,"context_depth",min(4,recipe["context_depth"]+1)),Map.put(recipe,"include_context",true),Map.put(recipe,"context_limit",min(64,recipe["context_limit"]*2)),Map.put(recipe,"chunk_bytes",max(128,div(recipe["chunk_bytes"],2))),Map.put(recipe,"chunk_bytes",min(4096,recipe["chunk_bytes"]*2)),Map.put(recipe,"tokenizer",if(recipe["tokenizer"]=="words",do: "identifiers",else: "words")),Map.put(recipe,"semantic_window",min(128,recipe["semantic_window"]*2)),if(recipe["semantic"],do: Map.put(recipe,"semantic_weight",min(16,recipe["semantic_weight"]+1)),else: recipe)]
