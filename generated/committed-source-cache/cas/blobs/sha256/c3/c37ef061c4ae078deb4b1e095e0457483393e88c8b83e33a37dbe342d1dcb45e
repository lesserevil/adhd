  def tls_roots(pem) do
    D.string(pem,65536)
    stripped=Regex.replace(~r/-----BEGIN CERTIFICATE-----[A-Za-z0-9+\/=\r\n\t ]+-----END CERTIFICATE-----/,pem,"")
    D.check(String.trim(stripped)=="")
    entries=:public_key.pem_decode(pem)
    D.list(entries,16,1)
    Enum.map(entries,fn entry->
      case entry do
        {:Certificate,der,:not_encrypted}->
          cert=:public_key.pkix_decode_cert(der,:otp)
          extensions=elem(elem(cert,1),10)
          D.check(is_list(extensions) and Enum.any?(extensions,fn extension->case extension do {:Extension,{2,5,29,19},_,{:BasicConstraints,true,_}}->true;_->false end end))
          der
        _->D.fail()
      end
    end)
  end
