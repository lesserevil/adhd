defmodule ADHD.Eventing do
  alias ADHD.Domain, as: D
  @json "application/vnd.kafka.json.v2+json"
  @plain "application/vnd.kafka.v2+json"
  @admin "application/json"
  def empty, do: %{version: 1,sequence: 0,events: %{},next_offset: 0,quarantine: %{},gap: nil,last_error: nil,binding: nil,control_revision: 0,audit: [],replays: %{},filter_schema: 1,filter_index: :gb_trees.empty(),filter_cursor: 0,filter_jobs: %{},filter_last_adapter: nil,filter_unavailable: 0,filter_ready: MapSet.new(),deferred_filters: 0}
  def enabled?(c), do: is_map(c["eventing"]) and c["eventing"]["enabled"] == true
  def normalize(c) do
    if Map.has_key?(c,"eventing") do
      v=c["eventing"]
      D.keys(v,~w(enabled rest_url topic_prefix timeout_ms retry_ms bearer_token tls_ca_pem retention_ms max_pending_events max_pending_bytes max_pending_filter_jobs max_pending_filter_jobs_per_subscription))
      v=Map.merge(%{"enabled"=>true,"rest_url"=>"http://127.0.0.1:8082","topic_prefix"=>"adhd","timeout_ms"=>3000,"retry_ms"=>1000,"retention_ms"=>604800000,"max_pending_events"=>100000,"max_pending_bytes"=>1073741824,"max_pending_filter_jobs"=>256,"max_pending_filter_jobs_per_subscription"=>64},v)
      D.boolean(v["enabled"]);D.url(v["rest_url"])
      uri=URI.parse(v["rest_url"]);D.check(is_nil(uri.userinfo) and is_nil(uri.query) and is_nil(uri.fragment))
      D.check(is_binary(v["topic_prefix"]) and Regex.match?(~r/^[A-Za-z0-9_-]{1,32}$/,v["topic_prefix"]))
      for key<-~w(timeout_ms retry_ms),do: D.integer(v[key],100,30000)
      D.integer(v["retention_ms"],3600000,31536000000)
      D.integer(v["max_pending_events"],1,1000000)
      D.integer(v["max_pending_bytes"],65536,1099511627776)
      for key<-~w(max_pending_filter_jobs max_pending_filter_jobs_per_subscription),do: D.integer(v[key],1,100000)
      if Map.has_key?(v,"tls_ca_pem"),do: tls_roots(v["tls_ca_pem"])
      if Map.has_key?(v,"bearer_token"),do: (D.string(v["bearer_token"],4096);D.check(byte_size(v["bearer_token"])>=24))
      Map.put(c,"eventing",v)
    else c end
  end
  def config(c) do
    normalize(Map.put_new(c,"eventing",%{"enabled"=>false}))["eventing"]
  end
  def project_policy(nil),do: %{}
  def project_policy(value) do
    D.keys(value,~w(topic_prefix retention_ms max_pending_events max_pending_bytes max_pending_filter_jobs max_pending_filter_jobs_per_subscription))
    policy=Map.reject(value,fn {_,v}->is_nil(v) end)
    config(%{"eventing"=>Map.merge(%{"enabled"=>false},policy)})
    policy
  end
  defp transition_policy(c),do: Map.take(config(c),~w(enabled rest_url topic_prefix bearer_token tls_ca_pem retention_ms))
  def subscription(cmd) do
    D.check(not (Map.has_key?(cmd,"filter") and Map.has_key?(cmd,"description")))
    criterion=cmd["filter"] || cmd["description"]
    mode=Map.get(cmd,"mode",if(Map.has_key?(cmd,"filter") or Map.has_key?(cmd,"description"),do: "filtered",else: "raw"))
    D.check(mode in ["raw","filtered"])
    if mode=="raw" do
      D.check(not Map.has_key?(cmd,"filter") and not Map.has_key?(cmd,"description"))
    else D.string(criterion,4096) end
    if Map.has_key?(cmd,"selectors") do
      D.keys(cmd["selectors"],~w(information_type source_kind source_id author_id))
      Enum.each(cmd["selectors"],fn {key,values}->
        D.list(values,64,1);D.distinct(values)
        Enum.each(values,fn value->
          case key do
            "author_id"->D.identifier(value)
            "information_type"->D.identifier(value)
            "source_kind"->D.identifier(value)
            "source_id"->D.string(value,256)
          end
        end)
      end)
    end
    if Map.has_key?(cmd,"paused"),do: D.boolean(cmd["paused"])
    :ok
  end
  def upgrade(s) do
    e=Map.merge(empty(),Map.get(s,:eventing,%{}))
    D.check(e.version==1 and is_integer(e.sequence) and e.sequence>=0 and is_integer(e.next_offset) and e.next_offset>=0)
    D.object(e.events);D.object(e.quarantine)
    old=Map.get(s,:eventing,%{})
    e=if Map.has_key?(old,:filter_schema),do: e,else: Map.delete(e,:filter_schema)
    Map.put(s,:eventing,e) |> filter_upgrade()
  end
  def topic(c,s) do
    prefix=c["eventing"]["topic_prefix"] || "adhd"
    epoch=c["topic_generation"]
    suffix=if is_nil(epoch),do: "",else: (D.check(is_binary(epoch) and Regex.match?(~r/\A[0-9a-f]{32}\z/,epoch));".r"<>epoch)
    prefix<>"."<>hash(s.server_id)<>"."<>hash(s.project)<>suffix<>".events.v1"
  end
  def restore_state(state,c,mode) when mode in ["restore","initialize"] do
    state=upgrade(state)
    D.check(state[:schema]==4 and state[:project_epoch]==c["project_epoch"] and
      c["topic_generation"]==state[:project_epoch])
    old=state.eventing
    events=Map.new(old.events,fn {id,row}->
      # Completed recipient choices and logical IDs survive. Only unfinished
      # accepted transport work is produced into the fresh topic.
      next=row |> Map.put(:offset,nil) |> Map.put(:broker_observed,false)
      next=if row.state==:materialized,do: next,else: next |> Map.put(:state,:pending) |> Map.put(:retry_at,0)
      {id,next}
    end)
    history=Map.get(old,:restore_history,[])
    history=if mode=="restore" do
      previous=%{binding: old.binding,next_offset: old.next_offset,quarantine: old.quarantine,
        gap: old.gap,last_error: old.last_error,
        offsets: Map.new(old.events,fn {id,row}->{id,row.offset} end)}
      history++[previous]
    else history end
    eventing=old |> Map.merge(%{events: events,next_offset: 0,quarantine: %{},gap: nil,
      last_error: nil,binding: binding(c,state)}) |> Map.put(:restore_history,history)
    %{state|eventing: eventing}
  end
  def preflight_restore(c,state,owning_deadline \\ nil) do
    D.check(state[:schema]==4 and c["topic_generation"]==state[:project_epoch])
    if enabled?(c) do
      deadline=provision_deadline(c,owning_deadline)
      provision(c,state,true,deadline)
      offsets=request_until(c,:get,"/topics/"<>topic(c,state)<>"/partitions/0/offsets",nil,@plain,@plain,deadline) |> success()
      # A fresh namespace cannot adopt even a truncated/reused nonzero log.
      D.check(offsets["beginning_offset"]===0 and offsets["end_offset"]===0)
    end
    :ok
  end
  defp hash(value),do: :crypto.hash(:sha256,value) |> Base.encode16(case: :lower) |> binary_part(0,16)
  defp binding(c,s),do: ADHD.Directory.digest(%{"server_id"=>s.server_id,"project_id"=>s.project,"topic"=>topic(c,s),"rest_url"=>c["eventing"]["rest_url"]})
  defp consumer_key(c,s),do: {binding(c,s),ADHD.Directory.digest(c["eventing"]),s.eventing.control_revision}
  defp fence(c),do: ADHD.Directory.digest(%{"eventing"=>c["eventing"],"config_revision"=>c["config_revision"]})
  def enqueue(s,c,p,subscriptions) do
    s=upgrade(s) |> remember_adapter(c);e=s.eventing
    pending=Enum.filter(e.events,fn {_,r}->r.state != :materialized end)
    bytes=Enum.reduce(pending,0,fn {_,r},n->n+r.bytes end)
    sequence=s.publications[p["id"]].seq
    event=%{"schema_version"=>1,"event_id"=>p["id"],"server_id"=>s.server_id,"project_id"=>s.project,"project_sequence"=>sequence,"publication_id"=>p["id"],"author_id"=>p["author_id"],"created_at"=>p["created_at"],"publication"=>p}
    encoded=JSON.encode!(event)
    D.check(byte_size(encoded)<=262144)
    subscriptions=Enum.filter(subscriptions,fn sub->sub["status"] != "paused" and sub["paused"] != true end) |> Enum.map(&freeze(&1,c,s.eventing.filter_last_adapter))
    cost=byte_size(encoded)+:erlang.external_size(subscriptions)
    if length(pending)>=c["eventing"]["max_pending_events"] or bytes+cost>c["eventing"]["max_pending_bytes"],do: D.fail("BACKPRESSURE")
    row=%{filter_registered: 0,filter_done: 0,filter_remaining: 0,filter_next: 0,event: event,subscriptions: subscriptions,state: :pending,offset: nil,bytes: cost,retry_at: 0,broker_observed: false}
    e=%{e|sequence: sequence,events: Map.put(e.events,event["event_id"],row)}
    {%{"event_id"=>event["event_id"],"project_sequence"=>sequence,"state"=>"pending"},%{s|eventing: e}}
  end
  def status(s,c) do
    s=upgrade(s);e=s.eventing;rows=Map.values(e.events)
    pending=Enum.filter(rows,&(&1.state != :materialized))
    watermark=fn state->rows |> Enum.filter(&(&1.state in state)) |> Enum.map(& &1.event["project_sequence"]) |> Enum.max(fn->0 end) end
    {ready,_}=ready_counts(s)
    %{"pending_filter_jobs"=>MapSet.size(ready),"deferred_filter_targets"=>e.deferred_filters,"filtering_paused"=>is_nil(c["matcher"]) or c["project_status"]=="archived","filter_queue_limits"=>Map.take(config(c),~w(max_pending_filter_jobs max_pending_filter_jobs_per_subscription)),"enabled"=>enabled?(c),"transport"=>if(enabled?(c),do: "kafka-rest-v2",else: "legacy"),"topic"=>if(enabled?(c),do: topic(c,s),else: nil),"accepted_watermark"=>e.sequence,"replay_watermark"=>replay_watermark(s),"control_revision"=>e.control_revision,"published_watermark"=>watermark.([:published,:observed,:materialized]),"materialized_watermark"=>watermark.([:materialized]),"next_offset"=>e.next_offset,"pending_events"=>length(pending),"pending_bytes"=>Enum.reduce(pending,0,&(&1.bytes+&2)),"quarantined"=>map_size(e.quarantine),"quarantines"=>Enum.map(Enum.sort(e.quarantine),fn {key,value}->Map.put(value,"offset",case Integer.parse(key) do {offset,""}->offset;_->nil end) end),"gap"=>e.gap,"last_error"=>e.last_error || if(e.filter_unavailable>0,do: %{"code"=>"FILTER_POLICY_UNAVAILABLE","at"=>D.now()},else: nil)}
  end
  def start,do: ADHD.Scope.spawn(fn->loop() end)
  defp loop do
    ADHD.Scope.begin_work()
    # A lost/restoring writer may reject even the error-recording callback.
    # Retire this unit, then let the existing worker begin in the new epoch.
    try do
      step()
    rescue _ -> :ok
    catch _, _ -> :ok end
    Process.sleep(100)
    loop()
  end
  def step do
    c=ADHD.Config.get()
    if enabled?(c) do
      try do
        s=ADHD.Store.call(fn state->next=stage_filters(state,ADHD.Config.get());{next,next} end) |> ADHD.Store.unwrap()
        ensure_topic(c,s)
        publish_next(c,s)
        consume(c)
      rescue
        _->failure(c,"BROKER_UNAVAILABLE")
      catch
        {:eventing,code}->failure(c,code)
        _,_->failure(c,"BROKER_UNAVAILABLE")
      end
    end
    :ok
  end
  defp failure(c,code) do
    case Process.delete(:adhd_kafka_consumer) do
      {_,path,previous}->close_owned_consumer(previous,path)
      _->:ok
    end
    ADHD.Store.call(fn s->
      s=upgrade(s)
      if fence(ADHD.Config.get())==fence(c),do: {:ok,put_in(s,[:eventing,:last_error],%{"code"=>code,"at"=>D.now()})},else: {:ok,s}
    end)
    # Bounded per-project retry; this worker owns no global capacity while waiting.
    Process.sleep(c["eventing"]["retry_ms"])
  end
  # Cleanup may outlive its target epoch. This sole server-context exception
  # deletes only the consumer endpoint previously recorded by this worker. It
  # cannot publish, fetch, commit, mutate project data or clear caller fences.
  defp close_owned_consumer(config,path) do
    previous={ADHD.Scope.id(),ADHD.Scope.epoch(),ADHD.Scope.fences()}
    ADHD.Scope.put(nil);ADHD.Scope.begin_work()
    try do request(config,:delete,path,nil) rescue _->:ok catch _,_->:ok
    after
      {id,epoch,fences}=previous
      ADHD.Scope.begin_work();ADHD.Scope.put(id);ADHD.Scope.put_epoch(epoch)
      for {project,captured}<-fences,do: ADHD.Scope.depend(project,captured)
    end
  end
  defp headers(c,accept),do: [{"accept",accept}]++if(c["eventing"]["bearer_token"],do: [{"authorization","Bearer "<>c["eventing"]["bearer_token"]}],else: [])
  defp request(c,method,path,body,content \\ @plain,accept \\ @plain) do
    request_until(c,method,path,body,content,accept,provision_deadline(c,nil))
  end
  defp request_until(c,method,path,body,content,accept,deadline) do
    ADHD.Resources.run(:eventing,remaining(deadline),fn granted->
      timeout=min(granted,remaining(deadline))
      request_now(c,method,path,body,content,accept,timeout,deadline)
    end)
  end
  defp monotonic_ms,do: System.monotonic_time(:millisecond)
  defp remaining(deadline) do
    left=deadline-monotonic_ms()
    if left<=0,do: throw({:eventing,"BROKER_TIMEOUT"})
    left
  end
  defp provision_deadline(c,nil),do: monotonic_ms()+c["eventing"]["timeout_ms"]
  defp provision_deadline(c,owner) when is_integer(owner),do: min(provision_deadline(c,nil),owner)
  defp request_now(c,method,path,body,content,accept,timeout,deadline) do
    timeout=min(timeout,remaining(deadline))
    url=String.trim_trailing(c["eventing"]["rest_url"],"/")<>path
    D.url(url)
    hs=Enum.map(headers(c,accept),fn {k,v}->{String.to_charlist(k),String.to_charlist(v)} end)
    req=if method in [:get,:delete],do: {String.to_charlist(url),hs},else: {String.to_charlist(url),hs,String.to_charlist(content),if(is_nil(body),do: "",else: JSON.encode!(body))}
    ssl=[verify: :verify_peer,reuse_sessions: false,cacerts: if(c["eventing"]["tls_ca_pem"],do: tls_roots(c["eventing"]["tls_ca_pem"]),else: :public_key.cacerts_get()),customize_hostname_check: [match_fun: :public_key.pkix_verify_hostname_match_fun(:https)]]
    # Per-request socket options bypass shared sessions and force Connection: close
    # in OTP's httpc manager. A project's long poll must not queue another's work.
    {:ok,id}=:httpc.request(method,req,[timeout: timeout,connect_timeout: timeout,autoredirect: false,ssl: ssl],[sync: false,stream: :self,body_format: :binary,socket_opts: [keepalive: false]])
    :ok=ADHD.Resources.track_http(id)
    response(id,deadline,[],0)
  end
  defp decode(""),do: nil
  defp decode(body),do: ADHD.JSON.decode!(body)
  defp response(id,deadline,chunks,size) do
    if monotonic_ms()>=deadline,do: (:httpc.cancel_request(id);throw({:eventing,"BROKER_TIMEOUT"}))
    receive do
      {:http,{^id,{{_,status,_},_,body}}}->
        D.check(byte_size(body)<=262144)
        {status,decode(body)}
      {:http,{^id,:stream_start,_}}->response(id,deadline,chunks,size)
      {:http,{^id,:stream,bytes}}->
        bytes=IO.iodata_to_binary(bytes)
        if size+byte_size(bytes)>262144,do: (:httpc.cancel_request(id);throw({:eventing,"BROKER_RESPONSE_TOO_LARGE"}))
        response(id,deadline,[bytes|chunks],size+byte_size(bytes))
      {:http,{^id,:stream_end,_}}->{200,chunks |> Enum.reverse() |> IO.iodata_to_binary() |> decode()}
      {:http,{^id,{:error,_}}}->throw({:eventing,"BROKER_UNAVAILABLE"})
    after max(0,deadline-monotonic_ms())->:httpc.cancel_request(id);throw({:eventing,"BROKER_TIMEOUT"})
    end
  end
  defp success({status,body}) when status in 200..299,do: body
  defp success(_),do: throw({:eventing,"BROKER_REQUEST_FAILED"})
  # Preflight performs no backend mutation. Only a durable config decision may
  # reset physical transport positions, and its ID makes crash recovery repeatable.
  def preflight(c,old) do
    try do
    affected=Enum.filter(ADHD.Projects.ids(c),fn id->
      view=ADHD.Projects.view(c,id)
      previous=if id in ADHD.Projects.ids(old),do: ADHD.Projects.view(old,id),else: nil
      # Existing unavailable projects inherit the new policy for recovery; do
      # not read their missing Store or accidentally admit them here. A genuinely
      # new Admin-created project still preflights its fresh topic before commit.
      (is_nil(previous) or ADHD.StorageRegistry.availability(old,id)=="ready") and
        enabled?(view) and (is_nil(previous) or transition_policy(view) != transition_policy(previous))
    end)
    if affected != [] do
      for id<-affected do
        view=ADHD.Projects.view(c,id)
        state=if id in ADHD.Projects.ids(old) do
          ADHD.Projects.scope(old,id,fn _->ADHD.Store.snapshot() |> ADHD.Store.unwrap() |> upgrade() end)
        else %{server_id: c["server_id"],project: id,eventing: empty()} end
        provision(view,state,false)
      end
      %{"id"=>D.opaque()}
    else nil end
    rescue _->D.fail("CONFIG_APPLY_FAILED")
    catch _,_->D.fail("CONFIG_APPLY_FAILED") end
  end
  def apply_transition(s,c,id) do
    s=upgrade(s);e=s.eventing
    if Map.get(e,:transition_id)==id do s else
      if enabled?(c),do: provision(c,s)
      next=if enabled?(c) and is_binary(e.binding) and e.binding != binding(c,s) do
        pending=e.events |> Enum.filter(fn {_,row}->row.state != :materialized end) |> Enum.map(&elem(&1,0)) |> Enum.sort()
        rows=Map.new(e.events,fn {key,row}->
          {key,if(row.state==:materialized,do: row,else: row |> Map.put(:state,:pending) |> Map.put(:offset,nil) |> Map.put(:broker_observed,false) |> Map.put(:retry_at,0))}
        end)
        history=Map.get(e,:transitions,[])++[%{"id"=>id,"previous_binding"=>e.binding,"previous_next_offset"=>e.next_offset,"quarantine"=>e.quarantine,"at"=>D.now()}]
        gap=%{"reason"=>"TRANSPORT_CUTOVER","from_offset"=>e.next_offset,"to_offset"=>0,"status"=>if(pending==[],do: "reconciled",else: "recovering"),"missing_event_ids"=>pending,"at"=>D.now()}
        %{e|events: rows,next_offset: 0,binding: binding(c,s),quarantine: %{},gap: gap,last_error: nil} |> Map.put(:transitions,history)
      else e end
      %{s|eventing: Map.put(next,:transition_id,id)}
    end
  end
  defp provision(c,s,apply_retention \\ true,owning_deadline \\ nil) do
    deadline=provision_deadline(c,owning_deadline)
    data=request_until(c,:get,"/v3/clusters",nil,@admin,@admin,deadline) |> success()
    clusters=data["data"];D.check(is_list(clusters) and length(clusters)==1)
    cluster=hd(clusters)["cluster_id"];D.check(is_binary(cluster))
    collection="/v3/clusters/"<>URI.encode(cluster,&URI.char_unreserved?/1)<>"/topics"
    path=collection<>"/"<>URI.encode(topic(c,s),&URI.char_unreserved?/1)
    {metadata,visibility}=case request_until(c,:get,path,nil,@admin,@admin,deadline) do
      {status,metadata} when status in 200..299->{metadata,false}
      {404,_}->
        body=%{"topic_name"=>topic(c,s),"partitions_count"=>1,"replication_factor"=>1,"configs"=>[%{"name"=>"cleanup.policy","value"=>"delete"},%{"name"=>"retention.ms","value"=>Integer.to_string(c["eventing"]["retention_ms"])}]}
        case request_until(c,:post,collection,body,@admin,@admin,deadline) do
          {status,metadata} when status in 200..299->
            D.check(is_map(metadata) and metadata["partitions_count"]===1)
            {nil,true}
          {400,%{"error_code"=>40002}}->{nil,true}
          _->throw({:eventing,"TOPIC_CREATE_FAILED"})
        end
      _->throw({:eventing,"TOPIC_UNAVAILABLE"})
    end
    entries=ready_topic(c,path,metadata,visibility,deadline)
    retention=Enum.find(entries,&(&1["name"]=="retention.ms"))
    desired=Integer.to_string(c["eventing"]["retention_ms"])
    if apply_retention and (not is_map(retention) or retention["value"]!=desired) do
      request_until(c,:post,path<>"/configs:alter",%{"data"=>[%{"name"=>"retention.ms","value"=>desired,"operation"=>"SET"}]},@admin,@admin,deadline) |> success()
      verified=ready_topic(c,path,nil,false,deadline)
      current=Enum.find(verified,&(&1["name"]=="retention.ms"))
      D.check(is_map(current) and current["value"]==desired)
    end
    :ok
  end
  defp ready_topic(c,path,metadata,visibility,deadline) do
    response=if is_nil(metadata),do: request_until(c,:get,path,nil,@admin,@admin,deadline),else: {200,metadata}
    case response do
      {404,_} when visibility->wait_topic(c,path,deadline)
      {status,metadata} when status in 200..299->
        D.check(is_map(metadata) and metadata["partitions_count"]===1)
        case request_until(c,:get,path<>"/configs",nil,@admin,@admin,deadline) do
          {404,_} when visibility->wait_topic(c,path,deadline)
          {status,configs} when status in 200..299->
            D.check(is_map(configs));entries=configs["data"]
            D.check(is_list(entries) and Enum.all?(entries,&is_map/1))
            cleanup=Enum.filter(entries,&(&1["name"]=="cleanup.policy"))
            retention=Enum.filter(entries,&(&1["name"]=="retention.ms"))
            D.check(length(cleanup)==1 and hd(cleanup)["value"]=="delete")
            D.check(length(retention)==1 and valid_retention?(hd(retention)["value"]))
            entries
          _->throw({:eventing,"BROKER_REQUEST_FAILED"})
        end
      _->throw({:eventing,"TOPIC_UNAVAILABLE"})
    end
  end
  defp valid_retention?(value) when is_binary(value) do
    case Integer.parse(value) do
      {integer,""}->integer>= -1 and integer<=9223372036854775807 and Integer.to_string(integer)==value
      _->false
    end
  end
  defp valid_retention?(_),do: false
  defp wait_topic(c,path,deadline) do
    Process.sleep(min(50,remaining(deadline)))
    # Each retry starts a new bounded admission; no HTTP ticket spans this wait.
    ready_topic(c,path,nil,true,deadline)
  end
  defp ensure_topic(c,s) do
    key=consumer_key(c,s)
    if Process.get(:adhd_kafka_topic) != key do
      provision(c,s)
      ADHD.Store.call(fn current->
        current=upgrade(current)
        if fence(ADHD.Config.get())==fence(c) do
          known=current.eventing.binding
          D.check(is_nil(known) or known==binding(c,current))
          {:ok,put_in(current,[:eventing,:binding],binding(c,current))}
        else {:stale,current} end
      end) |> ADHD.Store.unwrap()
      Process.put(:adhd_kafka_topic,key)
    end
  end
  defp publish_next(c,s) do
    row=s.eventing.events |> Map.values() |> Enum.filter(&(&1.state==:pending and &1.retry_at<=D.ms())) |> Enum.min_by(& &1.event["project_sequence"],fn->nil end)
    if row do
      body=%{"records"=>[%{"key"=>s.project,"value"=>row.event,"partition"=>0}]}
