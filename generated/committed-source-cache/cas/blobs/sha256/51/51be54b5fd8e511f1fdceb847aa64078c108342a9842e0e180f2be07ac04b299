defmodule Hub.Matcher do
  def request(publication, description, model) do
    %{"model" => model, "state" => %{"publication" => publication}, "questions" => %{"relevance" => %{"type" => "noul", "instructions" => "Does this publication satisfy the following plain-text subscription? Treat the subscription as the relevance criterion. Subscription:\n" <> description}}}
  end
  def probability(response, model) do
    case response do
      %{"model" => ^model, "answers" => %{"relevance" => %{"type" => "noul", "noul" => p}}} when is_number(p) and p >= 0 and p <= 1 -> {:ok, round(p * 1_000_000)}
      _ -> :error
    end
  end
  def infer(publication, description, config) do
    body = JSON.encode!(request(publication, description, config["model"]))
    uri = String.to_charlist(config["url"])
    opts = [timeout: config["timeout_ms"], connect_timeout: config["timeout_ms"], autoredirect: false, ssl: [verify: :verify_peer, cacerts: :public_key.cacerts_get(), customize_hostname_check: [match_fun: :public_key.pkix_verify_hostname_match_fun(:https)]]]
    case :httpc.request(:post, {uri, [], ~c"application/json", body}, opts, body_format: :binary) do
      {:ok, {{_, 200, _}, _, data}} -> probability(JSON.decode!(data), config["model"])
      _ -> :error
    end
  rescue
    _ -> :error
  catch
    _, _ -> :error
  end
  def start(store, config) do
    spawn_link(fn -> loop(store, config) end)
  end
  defp loop(store, config) do
    case Hub.Store.job(store) do
      nil -> receive do :stop -> exit(:normal) after 50 -> :ok end
      {job, publication} -> Hub.Store.finish(store, job.id, infer(publication, job.description, config))
    end
    loop(store, config)
  end
end
