defmodule Hub.HTTP do
  alias Hub.Validate, as: V
  @security [{"Cache-Control", "no-store"}, {"X-Content-Type-Options", "nosniff"}, {"Referrer-Policy", "no-referrer"}, {"Content-Security-Policy", "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"}]
  def start(store, cfg) do
    case :gen_tcp.listen(cfg["port"], [:binary, active: false, packet: :raw, ip: {127, 0, 0, 1}, reuseaddr: true, backlog: 128]) do
      {:ok, socket} -> {:ok, spawn(fn -> accept(socket, store, cfg) end)}
      e -> e
    end
  end
  def accept(listener, store, cfg) do
    case :gen_tcp.accept(listener) do
      {:ok, socket} ->
        pid = spawn(fn -> receive do {:socket, s} -> handle(s, store, cfg) end end)
        :ok = :gen_tcp.controlling_process(socket, pid)
        send(pid, {:socket, socket})
        accept(listener, store, cfg)
      _ -> :ok
    end
  end
  def receive_bytes(socket, data, deadline, mode) do
    timeout = max(1, deadline - System.monotonic_time(:millisecond))
    if timeout <= 1, do: throw({:http, 400})
    case mode do
      :headers ->
        case :binary.match(data, "\r\n\r\n") do
          {n, 4} ->
            if n + 4 > 16384, do: throw({:http, 431})
            {binary_part(data, 0, n), binary_part(data, n + 4, byte_size(data) - n - 4)}
          :nomatch ->
            if byte_size(data) > 16384, do: throw({:http, 431})
            {:ok, more} = :gen_tcp.recv(socket, 0, timeout)
            receive_bytes(socket, data <> more, deadline, :headers)
        end
      {:body, size} ->
        if byte_size(data) >= size do
          binary_part(data, 0, size)
        else
          {:ok, more} = :gen_tcp.recv(socket, min(size - byte_size(data), 65536), timeout)
          receive_bytes(socket, data <> more, deadline, mode)
        end
    end
  end
  def parse(socket) do
    deadline = System.monotonic_time(:millisecond) + 5000
    {head, initial} = receive_bytes(socket, "", deadline, :headers)
    [line | lines] = String.split(head, "\r\n")
    [method, path, version] = String.split(line, " ")
    if version not in ["HTTP/1.1", "HTTP/1.0"], do: throw({:http, 400})
    pairs = Enum.map(lines, fn line ->
      case String.split(line, ":", parts: 2) do
        [k, v] ->
          if !Regex.match?(~r/\A[!#$%&'*+.^_`|~0-9A-Za-z-]+\z/, k), do: throw({:http, 400})
          value = Regex.replace(~r/\A[ \t]+|[ \t]+\z/, v, "")
          if String.contains?(value, ["\r", "\n", <<0>>]), do: throw({:http, 400})
          {String.downcase(k), value}
        _ -> throw({:http, 400})
      end
    end)
    if Enum.any?(pairs, fn {k, _} -> k == "transfer-encoding" end), do: throw({:http, 400})
    if length(Enum.filter(pairs, fn {k, _} -> k == "content-length" end)) > 1, do: throw({:http, 400})
    if length(Enum.filter(pairs, fn {k, _} -> k in ["authorization", "host", "origin", "a2a-version", "content-type"] end)) != map_size(Map.new(Enum.filter(pairs, fn {k, _} -> k in ["authorization", "host", "origin", "a2a-version", "content-type"] end))), do: throw({:http, 400})
    headers = Map.new(pairs)
    size = case headers["content-length"] do
      nil -> 0
      value ->
        if !Regex.match?(~r/\A[0-9]+\z/, value), do: throw({:http, 400})
        if byte_size(value) > 12, do: throw({:http, 413})
        String.to_integer(value)
    end
    if size > 1_048_576, do: throw({:http, 413})
    {method, path, headers, receive_bytes(socket, initial, deadline, {:body, size})}
  end
  def handle(socket, store, cfg) do
    response = try do
      {method, path, headers, body} = parse(socket)
      route(method, path, headers, body, store, cfg)
    rescue
      _ -> json(400, %{"error" => %{"code" => "INVALID_PARAMS", "message" => "Invalid request"}})
    catch
      {:http, status} -> json(status, %{"error" => %{"code" => "INVALID_PARAMS", "message" => "Invalid request"}})
      _, _ -> json(500, %{"error" => %{"code" => "INTERNAL", "message" => "Request failed"}})
    end
    {status, type, body, headers} = response
    reason = %{200 => "OK", 400 => "Bad Request", 401 => "Unauthorized", 403 => "Forbidden", 404 => "Not Found", 409 => "Conflict", 413 => "Content Too Large", 415 => "Unsupported Media Type", 431 => "Request Header Fields Too Large", 500 => "Internal Server Error"}[status] || "Error"
    h = [{"Content-Type", type}, {"Content-Length", Integer.to_string(byte_size(body))}, {"Connection", "close"} | headers]
    :gen_tcp.send(socket, ["HTTP/1.1 #{status} #{reason}\r\n", Enum.map(h, fn {k, v} -> [k, ": ", v, "\r\n"] end), "\r\n", body])
    :gen_tcp.close(socket)
  end
  def json(status, obj, headers \\ []), do: {status, "application/json", JSON.encode!(obj), headers}
  def secure({s, t, b, h}), do: {s, t, b, @security ++ h}
  def error(status, code), do: json(status, %{"error" => %{"code" => code, "message" => "Request rejected"}})
  def equal?(a, b) when is_binary(a) and is_binary(b) do
    a = :crypto.hash(:sha256, a)
    b = :crypto.hash(:sha256, b)
    :crypto.hash_equals(a, b)
  end
  def equal?(_, _), do: false
  def bearer(h) do
    case h["authorization"] do
      "Bearer " <> token -> token
      _ -> nil
    end
  end
  def actor(headers, cfg) do
    token = bearer(headers)
    Enum.reduce(cfg["agents"], nil, fn {id, candidate}, acc -> if equal?(candidate, token), do: id, else: acc end)
  end
  def media?(h), do: String.downcase(h["content-type"] || "") |> String.split(";") |> hd() |> String.trim() == "application/json"
  def unauthorized, do: json(401, %{"error" => %{"code" => "UNAUTHORIZED", "message" => "Authentication required"}}, [{"WWW-Authenticate", "Bearer"}])
  def route("GET", "/health", _, _, store, _) do
    Hub.Store.snapshot(store)
    json(200, %{"status" => "ready"})
  end
  def route("GET", "/.well-known/agent-card.json", _, _, _, cfg), do: json(200, card(cfg))
  def route("GET", path, _, _, _, _) when path in ["/", "/admin", "/admin/"], do: secure({200, "text/html; charset=utf-8", Hub.Assets.html(), []})
  def route("GET", "/admin/assets/app.js", _, _, _, _), do: secure({200, "application/javascript; charset=utf-8", Hub.Assets.js(), []})
  def route("GET", "/admin/assets/app.css", _, _, _, _), do: secure({200, "text/css; charset=utf-8", Hub.Assets.css(), []})
  def route("POST", "/admin/api", h, body, store, cfg) do
    response = cond do
      !cfg["admin_token"] -> error(404, "NOT_FOUND")
      !equal?(bearer(h), cfg["admin_token"]) -> unauthorized()
      !origin?(h, cfg) -> error(403, "FORBIDDEN")
      !media?(h) -> error(415, "INVALID_PARAMS")
      true -> admin(body, store, cfg)
    end
    secure(response)
  end
  def route("POST", "/a2a", h, body, store, cfg) do
    cond do
      !media?(h) -> error(415, "INVALID_PARAMS")
      is_nil(actor(h, cfg)) -> unauthorized()
      true -> rpc(body, h, actor(h, cfg), store, cfg)
    end
  end
  def route(_, path, _, _, _, _) do
    r = error(404, "NOT_FOUND")
    if String.starts_with?(path, "/admin"), do: secure(r), else: r
  end
  def origin?(h, cfg) do
    is_nil(h["origin"]) or h["origin"] in ["http://#{h["host"]}", origin(cfg["public_url"])]
  end
  def origin(url) do
    u = URI.parse(url)
    %{u | path: nil, query: nil, fragment: nil} |> URI.to_string()
  end
  def admin(body, store, cfg) do
    try do
      c = JSON.decode!(body) |> V.admin()
      health = if c["op"] == "overview", do: Hub.Matcher.health(cfg), else: nil
      case Hub.Store.transition(store, fn s, config -> Hub.Domain.admin(s, c, config, health) end) do
        {:ok, result} -> json(200, result)
        {:error, code} -> error(%{"NOT_FOUND" => 404, "IDEMPOTENCY_CONFLICT" => 409}[code] || 400, code)
      end
    rescue
      _ -> error(400, "INVALID_PARAMS")
    end
  end
  def rpc_error(id, code, domain \\ nil) do
    e = %{"code" => code, "message" => if(domain, do: "Command rejected", else: "Invalid request")}
    e = if domain, do: Map.put(e, "data", [%{"@type" => "type.googleapis.com/google.rpc.ErrorInfo", "reason" => domain, "domain" => "adhd.hub", "metadata" => %{"code" => domain}}]), else: e
    json(200, %{"jsonrpc" => "2.0", "id" => id, "error" => e})
  end
  def rpc(body, headers, actor, store, cfg) do
    decoded = try do {:ok, JSON.decode!(body)} rescue _ -> :error end
    case decoded do
      :error -> rpc_error(nil, -32700)
      {:ok, e} ->
        id = if is_map(e), do: e["id"]
        cond do
          !is_map(e) or e["jsonrpc"] != "2.0" or !(is_binary(id) or is_integer(id)) or !is_binary(e["method"]) -> rpc_error(nil, -32600)
          headers["a2a-version"] not in [nil, "1.0"] -> rpc_error(id, -32602)
          e["method"] != "SendMessage" -> rpc_error(id, -32601)
          true ->
            try do
              params = e["params"]
              V.check(is_map(params))
              message = params["message"]
              V.check(is_map(message))
              V.id(message["messageId"])
              V.check(message["role"] == "ROLE_USER" and !Map.has_key?(message, "taskId") and !Map.has_key?(params, "taskId"))
              V.optional(message, "contextId", fn v -> V.check(is_binary(v) and String.valid?(v) and byte_size(v) > 0) end)
              V.check(is_list(message["parts"]) and length(message["parts"]) == 1)
              [part] = message["parts"]
              V.keys(part, ~w(data text mediaType))
              V.check(Map.has_key?(part, "data") != Map.has_key?(part, "text"))
              V.optional(part, "mediaType", fn v -> V.check(is_binary(v)) end)
              c = if Map.has_key?(part, "data"), do: part["data"], else: JSON.decode!(part["text"])
              V.command(c)
              case Hub.Store.transition(store, fn s, config -> Hub.Domain.command(s, c, actor, message["messageId"], config) end) do
                {:ok, result} ->
                  server_id = "server-" <> Base.encode16(:crypto.strong_rand_bytes(16), case: :lower)
                  json(200, %{"jsonrpc" => "2.0", "id" => id, "result" => %{"message" => %{"messageId" => server_id, "contextId" => Map.get(message, "contextId", cfg["project_id"]), "role" => "ROLE_AGENT", "parts" => [%{"data" => result}]}}})
                {:error, code} when code in ~w(NOT_FOUND FORBIDDEN IDEMPOTENCY_CONFLICT SOURCE_CONFLICT PROJECT_MISMATCH) -> rpc_error(id, -32000, code)
                {:error, "INVALID_PARAMS"} -> rpc_error(id, -32602)
                _ -> rpc_error(id, -32603)
              end
            rescue
              _ -> rpc_error(id, -32602)
            end
        end
    end
  end
  def card(cfg) do
    %{"name" => "ADHD", "description" => "Agentic Distributed Harness Depot (ADHD): a private A2A information hub for agent coordination.", "version" => "0.1.0",
      "supportedInterfaces" => [%{"url" => cfg["public_url"] <> "/a2a", "protocolBinding" => "JSONRPC", "protocolVersion" => "1.0"}],
      "capabilities" => %{"streaming" => false, "pushNotifications" => false, "extendedAgentCard" => false},
      "defaultInputModes" => ["application/json"], "defaultOutputModes" => ["application/json"],
      "securitySchemes" => %{"bearerAuth" => %{"httpAuthSecurityScheme" => %{"scheme" => "bearer"}}},
      "securityRequirements" => [%{"schemes" => %{"bearerAuth" => %{"list" => []}}}],
      "skills" => [%{"id" => "project-coordination", "name" => "Project coordination", "description" => "Publish project information, subscribe, poll, search and exchange addressed messages.", "tags" => ["coordination"], "inputModes" => ["application/json"], "outputModes" => ["application/json"]}]}
  end
end

