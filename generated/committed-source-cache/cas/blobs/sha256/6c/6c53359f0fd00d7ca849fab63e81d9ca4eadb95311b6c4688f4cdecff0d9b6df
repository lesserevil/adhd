  def js do
    ~S"""
    'use strict';
    (()=>{
    let token='',view='Overview',revision=0,busy=false,uncertain=null,agents=[],lastFilters={};
    const $=id=>document.getElementById(id), content=$('content');
    const node=(tag,text,cls)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=text;if(cls)e.className=cls;return e;};
    const button=(text,fn)=>{const b=node('button',text);b.type='button';b.addEventListener('click',fn);return b;};
    function logout(){token='';uncertain=null;revision++;agents=[];lastFilters={};content.replaceChildren();$('project').textContent='';$('state').textContent='';$('error').textContent='';$('login-error').textContent='';$('guide').hidden=true;$('console').hidden=true;$('login').hidden=false;$('token').value='';}
    async function api(command){let r;try{r=await fetch('/admin/api',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},body:JSON.stringify(command)});}catch(e){throw new Error('Service could not be reached. Retry when the connection is available.');}if(r.status===401){logout();$('login-error').textContent='Sign in with a valid administrator token.';throw new Error('Sign in with a valid administrator token.');}if(!r.ok){throw new Error(r.status===409?'This request identifier has already been used for another action.':'Request could not be completed. Check the fields and retry.');}return await r.json();}
    function field(form,label,name,type='text',value=''){const id='field-'+name;const l=node('label',label);l.htmlFor=id;const e=node(type==='textarea'?'textarea':'input');if(type!=='textarea')e.type=type;e.id=id;e.name=name;e.value=value;form.append(l,e);return e;}
    function select(form,label,name,options){const l=node('label',label);l.htmlFor='field-'+name;const e=node('select');e.id=l.htmlFor;e.name=name;options.forEach(o=>{const v=node('option',o.label||o);v.value=o.value===undefined?o:o.value;e.append(v);});form.append(l,e);return e;}
