  def apply_command(s, c, a, %{"op" => "federated_query"} = cmd) do
    f = c["federation"] || D.fail("FEDERATION_DISABLED")

    if Enum.count(s.queries, fn {_, q} -> q["status"] == "pending" end) >= 64 do
      D.fail("RESOURCE_EXHAUSTED")
    end

    {id, s} = alloc(s, "query")

    peers =
      Enum.map(f["peers"], fn p ->
        Map.take(p, ~w(server_id project_id)) |> Map.put("status", "pending")
      end)

    q = %{
      "id" => id,
      "project_id" => c["project_id"],
      "owner_id" => a,
      "question" => cmd["question"],
      "created_at" => D.now(),
      "deadline_at" =>
        DateTime.from_unix!(D.ms() + Map.get(cmd, "deadline_ms", 30000), :millisecond)
        |> DateTime.to_iso8601(),
      "status" =>
        if peers == [] do
          "completed"
        else
          "pending"
        end,
      "peers" => peers,
      "responses" => []
    }

    {%{"query" => q}, put_in(s, [:queries, id], q)}
  end

  def apply_command(s, _, a, %{"op" => op, "query_id" => id})
      when op in ["get_federated_query", "cancel_federated_query"] do
    q = s.queries[id] || D.fail("NOT_FOUND")

    if q["owner_id"] != a do
      D.fail("FORBIDDEN")
    end

    q = expire(q)

    q =
      if op == "cancel_federated_query" and q["status"] == "pending" do
        Map.put(q, "status", "cancelled")
      else
        q
      end

    {%{"query" => q}, put_in(s, [:queries, id], q)}
  end

  def remove_subscription(s, id) do
    jobs =
      Map.new(s.jobs, fn {k, j} ->
        {k,
         if j.subscription_id == id and j.status == :pending do
           %{j | status: :cancelled}
         else
           j
         end}
      end)

    %{s | subscriptions: Map.delete(s.subscriptions, id), jobs: jobs}
  end

  def expire(q) do
    if q["status"] == "pending" and D.epoch(q["deadline_at"]) <= D.ms() do
      Map.put(q, "status", "partial")
    else
      q
    end
  end

  def search(s, cmd) do
    values(s, :publications)
    |> Enum.reverse()
    |> Enum.filter(fn p ->
      Enum.all?(
        [
          {"information_type", p["information_type"]},
          {"source_kind", p["source"]["kind"]},
          {"source_id", p["source"]["id"]}
        ],
        fn {k, v} -> not Map.has_key?(cmd, k) or cmd[k] == v end
      ) and
        (not Map.has_key?(cmd, "query") or
           Enum.any?(
             [
               p["text"],
               JSON.encode!(p["data"]),
               p["information_type"],
               JSON.encode!(p["source"])
             ],
             &String.contains?(String.downcase(&1), String.downcase(cmd["query"]))
           ))
    end)
  end

  def complete_job(s, id, ppm, c) do
    case s.jobs[id] do
      %{status: :pending} = j ->
        cond do
          not Map.has_key?(s.subscriptions, j.subscription_id) ->
            put_in(s, [:jobs, id, :status], :cancelled)

          not Map.has_key?(c["agents"], j.recipient_id) ->
            s

          true ->
            s = put_in(s, [:jobs, id, :status], :done)

            if ppm >= Map.get(j, :threshold_ppm, c["threshold_ppm"]) do
              p = s.publications[j.publication_id].value

              evidence = %{
                "subscription_id" => j.subscription_id,
                "probability_ppm" => ppm,
                "threshold_ppm" => Map.get(j, :threshold_ppm, c["threshold_ppm"]),
                "model" =>
                  get_in(j, [:filter_policy, "matcher", "model"]) || c["matcher"]["model"]
              }

              evidence =
                if Map.has_key?(j, :subscription_revision) do
                  Map.merge(evidence, %{
                    "subscription_revision" => j.subscription_revision,
                    "mode" => "filtered"
                  })
                else
                  evidence
                end

              evidence =
                if Map.get(j, :replay_id) do
                  Map.put(evidence, "replay_id", j.replay_id)
                else
                  evidence
                end

              existing =
                Enum.find(s.deliveries, fn {_, r} ->
                  r.value["publication_id"] == j.publication_id and
                    r.value["recipient_id"] == j.recipient_id
                end)

              if existing do
                {did, row} = existing

                put_in(
                  s,
                  [:deliveries, did, :value, "matches"],
                  row.value["matches"] ++ [evidence]
                )
              else
                {did, s} = alloc(s, "delivery")

                d =
                  Map.take(
                    p,
                    if Map.has_key?(j, :subscription_revision) do
                      ~w(project_id author_id text data information_type source occurred_at)
                    else
                      ~w(project_id text data information_type source occurred_at)
                    end
                  )
                  |> Map.merge(%{
                    "id" => did,
                    "recipient_id" => j.recipient_id,
                    "sender_id" => p["author_id"],
                    "kind" => "publication",
                    "publication_id" => p["id"],
                    "created_at" => D.now(),
                    "matches" => [evidence]
                  })

                put_in(s, [:deliveries, did], %{seq: s.seq, value: d, ack: false})
              end
            else
              s
            end
        end

      _ ->
        s
    end
  end

  def event_job(s, p, sub, c \\ ADHD.Config.get()) do
    policy =
      sub["_filter_policy"] ||
        %{
          "threshold_ppm" => c["threshold_ppm"],
          "matcher" => Map.take(c["matcher"] || %{}, ~w(model url timeout_ms retry_ms))
        }

    existing =
      ADHD.Eventing.existing_filter_job?(s, p["id"], sub["id"], Map.get(sub, "revision", 1))

    if existing do
      s
    else
      {jid, s} = alloc(s, "job")

      job = %{
        filter_policy: policy,
        replay_id: sub["_replay_id"],
        id: jid,
        seq: s.seq,
        publication_id: p["id"],
        subscription_id: sub["id"],
        recipient_id: sub["agent_id"],
        description: sub["filter"] || sub["description"],
        subscription_revision: Map.get(sub, "revision", 1),
        threshold_ppm: policy["threshold_ppm"],
        status: :pending,
        retry_at: 0
      }

      put_in(s, [:jobs, jid], job) |> ADHD.Eventing.track_filter_job(job)
    end
  end

  def event_delivery(s, p, sub, evidence) do
    existing =
      Enum.find(s.deliveries, fn {_, row} ->
        row.value["publication_id"] == p["id"] and row.value["recipient_id"] == sub["agent_id"]
      end)

    if existing do
      {id, row} = existing
      reasons = row.value["matches"]

      next =
        if evidence in reasons do
          reasons
        else
          reasons ++ [evidence]
        end

      put_in(s, [:deliveries, id, :value, "matches"], next)
    else
      {id, s} = alloc(s, "delivery")

      value =
        Map.take(p, ~w(project_id author_id text data information_type source occurred_at))
        |> Map.merge(%{
          "id" => id,
          "recipient_id" => sub["agent_id"],
          "sender_id" => p["author_id"],
          "kind" => "publication",
          "publication_id" => p["id"],
          "created_at" => D.now(),
          "matches" => [evidence]
        })

      put_in(s, [:deliveries, id], %{seq: s.seq, value: value, ack: false})
    end
  end

  def admin_execute(s, c, cmd, actor \\ "legacy-admin") do
    D.admin(cmd)

    if is_binary(cmd["agent_id"]) and cmd["op"] != "query_jobs" and
         not Map.has_key?(c["agents"], cmd["agent_id"]) do
      D.fail("NOT_FOUND")
    end

    apply = fn state ->
      if cmd["op"] in ADHD.Eventing.controls() do
        ADHD.Eventing.admin(state, c, cmd, actor)
      else
        admin_apply(state, c, cmd)
      end
    end

    if cmd["op"] in ~w(create_subscription update_subscription remove_subscription retry_jobs cancel_query_job rebuild_index repair_eventing replay_events) do
      key = {actor, cmd["message_id"]}

      previous =
        s.admin_idempotency[key] ||
          if actor == "legacy-admin" do
            s.admin_idempotency[cmd["message_id"]]
          end

      case previous do
        %{command: ^cmd, result: r} ->
          {r, s}

        nil ->
          {r, n} = apply.(s)
          {r, put_in(n, [:admin_idempotency, key], %{command: cmd, result: r})}

        _ ->
          D.fail("IDEMPOTENCY_CONFLICT")
      end
    else
      apply.(s)
    end
  end

  defp page(items, c) do
    n = Map.get(c, "limit", 50)
    %{"items" => Enum.take(items, n), "truncated" => length(items) > n}
  end

  defp admin_apply(s, c, %{"op" => "retrieval_index"}) do
    {%{"index" => ADHD.RetrievalIndex.read(s, c)}, s}
  end

  defp admin_apply(s, c, %{"op" => "rebuild_index"} = cmd) do
    if cmd["expected_revision"] != c["config_revision"] do
      D.fail("CONFIG_CONFLICT")
    end

    ADHD.RetrievalIndex.rebuild(s, c)
  end

  defp admin_apply(s, c, %{"op" => op} = cmd)
       when op in ~w(query_jobs query_job cancel_query_job) do
    ADHD.SourceQueries.admin(s, c, cmd)
  end

  defp admin_apply(s, c, %{"op" => "overview"}) do
    queued = Enum.filter(Map.values(s.deliveries), &(not &1.ack))

    agents =
      Enum.map(Enum.sort(Map.keys(c["agents"])), fn a ->
        %{
          "agent_id" => a,
          "subscriptions" => Enum.count(values(s, :subscriptions), &(&1["agent_id"] == a)),
          "queued_deliveries" => Enum.count(queued, &(&1.value["recipient_id"] == a))
        }
      end)

    counts = %{
      "agents" => length(agents),
      "publications" => map_size(s.publications),
      "subscriptions" => map_size(s.subscriptions),
      "queued_deliveries" => length(queued),
      "pending_jobs" => Enum.count(s.jobs, fn {_, j} -> j.status == :pending end),
      "completed_jobs" => Enum.count(s.jobs, fn {_, j} -> j.status == :done end),
      "cancelled_jobs" => Enum.count(s.jobs, fn {_, j} -> j.status == :cancelled end)
    }

    {%{
       "project_id" => c["project_id"],
       "counts" => counts,
       "agents" => agents,
       "matcher" => ADHD.Workers.health(c)
     }, s}
  end

  defp admin_apply(s, c, %{"op" => "record"} = cmd) do
    {ADHD.Records.read(s, c, cmd), s}
  end

  defp admin_apply(s, c, %{"op" => "publication", "publication_id" => id}) do
    apply_command(s, c, nil, %{"op" => "get", "publication_id" => id})
  end

  defp admin_apply(s, c, %{"op" => "publications"} = cmd) do
    {page(Enum.map(search(s, cmd), &project(&1, c)), cmd), s}
  end

  defp admin_apply(s, c, %{"op" => "subscriptions"} = cmd) do
    items =
      values(s, :subscriptions)
      |> Enum.reverse()
      |> Enum.filter(&(is_nil(cmd["agent_id"]) or &1["agent_id"] == cmd["agent_id"]))
      |> Enum.map(&project(&1, c))

    {page(Enum.drop(items, Map.get(cmd, "offset", 0)), cmd), s}
  end

  defp admin_apply(s, _, %{"op" => "deliveries"} = cmd) do
    items =
      rows(s, :deliveries)
      |> Enum.reverse()
      |> Enum.filter(&(is_nil(cmd["agent_id"]) or &1.value["recipient_id"] == cmd["agent_id"]))
      |> Enum.map(fn r ->
        Map.take(r.value, ~w(recipient_id kind created_at publication_id))
        |> Map.merge(%{"delivery_id" => r.value["id"], "acknowledged" => r.ack})
      end)

    {page(items, cmd), s}
  end

  defp admin_apply(s, _, %{"op" => "jobs"} = cmd) do
    items =
      Map.values(s.jobs)
      |> Enum.sort_by(& &1.seq, :desc)
      |> Enum.filter(&(is_nil(cmd["status"]) or Atom.to_string(&1.status) == cmd["status"]))
      |> Enum.map(fn j ->
        %{
          "job_id" => j.id,
          "publication_id" => j.publication_id,
          "subscription_id" => j.subscription_id,
          "recipient_id" => j.recipient_id,
          "status" => Atom.to_string(j.status),
          "retry_at" => j.retry_at
        }
      end)

    {page(items, cmd), s}
  end

  defp admin_apply(s, c, %{"op" => "update_subscription"} = cmd) do
    row = s.subscriptions[cmd["subscription_id"]] || D.fail("NOT_FOUND")
    owner = row.value["agent_id"]

    if not Map.has_key?(c["agents"], owner) do
      D.fail("NOT_FOUND")
    end

    apply_command(
      s,
      c,
      owner,
      Map.take(
        cmd,
        ~w(op subscription_id expected_revision mode selectors filter description paused)
      )
    )
  end

  defp admin_apply(s, c, %{"op" => "create_subscription"} = cmd) do
    apply_command(
      s,
      c,
      cmd["agent_id"],
      Map.take(cmd, ~w(description filter mode selectors)) |> Map.put("op", "subscribe")
    )
  end

  defp admin_apply(s, _, %{"op" => "remove_subscription", "subscription_id" => id}) do
    if is_nil(s.subscriptions[id]) do
      D.fail("NOT_FOUND")
    end

    {%{"removed" => true, "subscription_id" => id}, remove_subscription(s, id)}
  end

  defp admin_apply(s, _, %{"op" => "retry_jobs"}) do
    count = Enum.count(s.jobs, fn {_, j} -> j.status == :pending end)

    jobs =
      Map.new(s.jobs, fn {id, j} ->
        {id,
         if j.status == :pending do
           %{j | retry_at: 0}
         else
           j
         end}
      end)

    {%{"retried" => count}, %{s | jobs: jobs}}
  end

  defp admin_apply(s, c, %{"op" => "private_delivery", "delivery_id" => id}) do
    row = s.deliveries[id] || D.fail("NOT_FOUND")
    {%{"delivery" => project(row.value, c)}, s}
  end
end