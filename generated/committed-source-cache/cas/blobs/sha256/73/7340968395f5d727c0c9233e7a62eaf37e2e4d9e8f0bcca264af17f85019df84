  def durable_tests do
    root=Path.join(System.tmp_dir!(),"adhd-native-"<>D.opaque()); File.mkdir_p!(root)
    c=config() |> Map.put("store_path",Path.join(root,"state.dets"))
    path=Path.join(root,"config.json"); File.write!(path,JSON.encode!(c))
    try do
      File.chmod!(root,0o700);File.chmod!(path,0o600)
      ADHD.Storage.write_closed(c["store_path"],ADHD.Store.empty(c["project_id"]) |> ADHD.Storage.next())
      {:ok,_}=ADHD.Config.start_link(path)
      c=ADHD.Projects.view(ADHD.Config.root(),c["project_id"])
      {:ok,_}=ADHD.Store.start_link(c)
      cmd=%{"op"=>"publish","data"=>%{"native"=>true},"source"=>%{"kind"=>"slack","id"=>"native-channel","item_id"=>"native-stable"}}
      r=ADHD.Store.command("native-a","persistent-1",cmd) |> ADHD.Store.unwrap()
      GenServer.stop(ADHD.Store)
      {:ok,_}=ADHD.Store.start_link(c)
      equal(ADHD.Store.command("native-a","persistent-2",cmd) |> ADHD.Store.unwrap(),r)
      equal(ADHD.Store.command("native-a","persistent-3",Map.put(cmd,"data",false)),{:error,"SOURCE_CONFLICT"})
      s=ADHD.Store.snapshot() |> ADHD.Store.unwrap()
      GenServer.stop(ADHD.Store)
      saved=File.read!(ADHD.Storage.snapshot_path(c["store_path"]))
      <<"ADHDSTATE",1,digest::binary-size(32),body::binary>>=saved
      equal(:crypto.hash(:sha256,body),digest)
      equal(File.stat!(ADHD.Storage.snapshot_path(c["store_path"])).mode |> Bitwise.band(0o777),0o600)
      # The durable companion reconstructs a missing checkpoint, preserving all
      # source receipts rather than creating a fresh empty archive.
      File.rm!(c["store_path"])
      {:ok,_}=ADHD.Store.start_link(c)
      equal(ADHD.Store.command("native-a","persistent-1",cmd) |> ADHD.Store.unwrap(),r)
      GenServer.stop(ADHD.Store)
      File.write!(ADHD.Storage.snapshot_path(c["store_path"]),"invalid snapshot")
      invalid_snapshot=try do
        ADHD.Storage.read_snapshot(c["store_path"]);:accepted
      catch {:recovery,"RESTORE_INVALID_BACKUP","snapshot_integrity"}->:rejected end
      equal(invalid_snapshot,:rejected)
      File.write!(ADHD.Storage.snapshot_path(c["store_path"]),saved)
      failed=try do
        ADHD.Storage.persist(:adhd_closed_native,Path.join(root,"failed.dets"),ADHD.Store.empty(c["project_id"]))
        :continued
      catch :exit,:storage_commit_failed->:stopped end
      equal(failed,:stopped)
      # Original schema-2 sources entries survive the upgrader exactly.
      upgraded=ADHD.Store.upgrade(Map.drop(s,[:admin_idempotency,:queries,:incoming,:aliases]),c["project_id"])
      equal(upgraded.sources,s.sources)
      {r2,_}=ADHD.Store.execute(upgraded,c,"native-a","schema2-retry",cmd); equal(r2,r)
      # Seed a true schema-1 disk object, then let the product store open it.
      # This is an isolated legacy fixture, not a partial restore of a new store.
      GenServer.stop(ADHD.Config)
      :persistent_term.erase({ADHD.StorageRegistry,:current});:persistent_term.erase({ADHD.Config,:config})
      ADHD.Scope.begin_work();ADHD.Scope.put(nil)
      legacy_root=Path.join(root,"legacy");File.mkdir!(legacy_root);File.chmod!(legacy_root,0o700)
      legacy_config=config() |> Map.put("store_path",Path.join(legacy_root,"state.dets"))
      legacy_path=Path.join(legacy_root,"config.json");File.write!(legacy_path,JSON.encode!(legacy_config));File.chmod!(legacy_path,0o600)
      legacy_pub=Map.drop(r["publication"],~w(information_type source occurred_at))
      legacy=%{schema: 1,project: c["project_id"],seq: 1,subscriptions: %{},publications: %{legacy_pub["id"]=>%{seq: 1,value: legacy_pub}},deliveries: %{},jobs: %{},idempotency: %{{"native-a","historical"}=>%{command: %{"op"=>"publish","data"=>%{}},result: %{"publication"=>legacy_pub,"matching"=>"pending"}}}}
      {:ok,t}=:dets.open_file(:adhd_native_fixture,[file: String.to_charlist(legacy_config["store_path"]),type: :set])
      File.chmod!(legacy_config["store_path"],0o600)
      :dets.insert(t,{:state,legacy}); :dets.sync(t); :dets.close(t)
      {:ok,_}=ADHD.Config.start_link(legacy_path)
      c=ADHD.Projects.view(ADHD.Config.root(),legacy_config["project_id"])
      {:ok,_}=ADHD.Store.start_link(c)
      loaded=ADHD.Store.snapshot() |> ADHD.Store.unwrap()
      equal(loaded.publications[legacy_pub["id"]].value["source"],%{"kind"=>"agent","id"=>"native-a"})
      historical=ADHD.Store.command("native-a","historical",%{"op"=>"publish","data"=>%{}}) |> ADHD.Store.unwrap()
      equal(historical,%{"publication"=>legacy_pub,"matching"=>"pending"})
    after
      if Process.whereis(ADHD.Store),do: GenServer.stop(ADHD.Store)
      if Process.whereis(ADHD.Config),do: GenServer.stop(ADHD.Config)
      File.rm_rf!(root)
    end
  end
  def validate_schema(value,schema,defs) do
    if schema["$ref"] do
      validate_schema(value,Map.fetch!(defs,String.replace_prefix(schema["$ref"],"#/$defs/","")),defs)
    else
      case schema["type"] do
        "object"->
          equal(is_map(value),true)
          Enum.each(schema["required"] || [],fn k->equal(Map.has_key?(value,k),true) end)
          for {k,v}<-value do
            rule=schema["properties"][k]
            if rule,do: validate_schema(v,rule,defs),else: equal(schema["additionalProperties"] != false,true)
          end
        "array"->equal(is_list(value),true); Enum.each(value,&validate_schema(&1,schema["items"],defs))
        "string"->equal(is_binary(value),true)
        "integer"->equal(is_integer(value),true)
        "boolean"->equal(is_boolean(value),true)
        _->:ok
      end
    end
  end
