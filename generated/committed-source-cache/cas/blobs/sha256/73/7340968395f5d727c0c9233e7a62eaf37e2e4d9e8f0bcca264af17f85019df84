  def selection_tests do
    alias ADHD.Selection,as: S
    alias ADHD.Retrieval,as: X
    alias ADHD.RetrievalIndex,as: I
    c=config();s=admitted_empty(c["project_id"])
    {_,s}=ADHD.Store.execute(s,c,"native-a","selection-original",%{"op"=>"publish_record","text"=>"Native immutable selection evidence."})
    build=fn state,recipe->
      cc=ADHD.Replay.config_for(X.resolve(c,state),recipe)
      prepared=I.begin_build(state,cc);g=prepared.retrieval_index["building"]
      rows=Map.new(g["target_ids"],fn id->{id,X.make_row(state,cc,id,recipe,g["manifest"]["source_watermark"])} end)
      g=g |> Map.merge(%{"rows"=>rows,"pending_ids"=>[],"done"=>map_size(rows)}) |> then(&I.refresh_manifest(state,&1)) |> put_in(["manifest","status"],"ready")
      {g,%{state|allocation_counter: prepared.allocation_counter}}
    end
    base=S.base(c);{old,s}=build.(s,base);s=put_in(s,[:retrieval_index,"active"],old)
    recipe=Map.put(base,"context_depth",min(4,base["context_depth"]+1));{candidate,s}=build.(s,recipe)
    descriptor=S.descriptor(recipe,c,"native-selection-proof",String.duplicate("f",64),ADHD.Records.watermark(s),ADHD.Records.watermark(s))
    state=S.activate(s,c,descriptor,candidate)
    equal(S.view(state,c)["applied"],true);equal(S.view(state,c)["effective_recipe"],recipe)
    equal(S.view(state,c)["base_recipe"],base);equal(S.view(state,c)["qualification_current"],true)
    equal(S.base_identity(c),S.base_identity(X.resolve(c,state)));equal(X.config(c)["recipe"],base)
    equal(X.effective(X.resolve(c,state))["recipe"],recipe);equal(S.protected_previous?(state,c),true)
    equal(state.retrieval_index["active"]["manifest"]["recipe"],recipe);equal(state.retrieval_index["previous"],old)
    equal(S.upgrade(state),state);equal(I.upgrade(state),state)
    ranking=Map.put(recipe,"semantic_window",recipe["semantic_window"]+1)
    private=%{"winner_identity"=>X.recipe_identity(ranking),"variants"=>[%{"recipe_identity"=>X.recipe_identity(ranking),"recipe"=>ranking}]}
    {reused,count,counter}=ADHD.OptimizationWorker.prepare_generation(state,c,private)
    equal(counter,state.allocation_counter+1)
    equal(count,map_size(candidate["rows"]));equal(reused["pending_ids"],[]);equal(reused["done"],0);equal(reused["manifest"]["recipe"],ranking)
    {_,published}=ADHD.Store.execute(state,c,"native-a","selection-catchup",%{"op"=>"publish_record","text"=>"A newer contextual original.","context"=>%{"links"=>[%{"relation"=>"reply","publication_id"=>hd(candidate["target_ids"])}]}})
    {extended,_,counter}=ADHD.OptimizationWorker.prepare_generation(published,c,private)
    equal(counter,published.allocation_counter+1)
    equal(length(extended["pending_ids"])>0,true);equal(extended["manifest"]["source_watermark"],ADHD.Records.watermark(published))
    branch=ADHD.Replay.config_for(X.resolve(c,state),base);equal(X.effective(X.resolve(branch,state))["recipe"],base);equal(branch["__global_retrieval_recipe"],recipe)
    damaged=put_in(state,[:retrieval_index,"active","rows"],%{"invalid"=>%{}}) |> I.upgrade()
    equal(damaged.retrieval_index["active"],nil);equal(damaged.retrieval_selection,state.retrieval_selection);equal(S.view(damaged,c)["effective_recipe"],recipe)
    migrated=put_in(state,[:retrieval_selection,"selected","qualification_runtime"],"another-runtime") |> S.upgrade()
    equal(S.view(migrated,c)["qualification_current"],false);equal(S.view(migrated,c)["effective_recipe"],recipe)
    unrelated=Map.put(c,"port",19877);equal(S.applied?(state,unrelated),true)
    newbase=Map.put(c,"retrieval",%{"recipe"=>Map.put(base,"context_limit",min(64,base["context_limit"]+1))});equal(S.applied?(state,newbase),false)
    cleared=S.reset(state,"native-reset-decision");equal(cleared.retrieval_selection["revision"],2);equal(S.reset(cleared,"native-reset-decision"),cleared);equal(cleared.retrieval_selection["selected"],nil)
    equal(cleared.publications,state.publications);equal(cleared.deliveries,state.deliveries)
    rejects(fn->S.upgrade(put_in(state,[:retrieval_selection,"selected","base_identity"],"invalid")) end)
  end
  def optimization_tests do
