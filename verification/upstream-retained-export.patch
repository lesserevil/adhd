+"""Retained lookup preserves reviewed namespaces without executable authority."""
+
+from __future__ import annotations
+
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from literate_ai.adapters.cache.generated_source import CachedCodingCliSourceGenerator
+from literate_ai.adapters.models.coding_cli import (
+    AcceptedRetainedSourceSelection,
+    CodingCliError,
+    CodingCliSourceGenerator,
+)
+from literate_ai.adapters.retained_source import RetainedSourceInput
+from literate_ai.contracts import canonical_identity
+from literate_ai.contracts.model_scopes import (
+    RETAINED_SOURCE_NO_MODEL_SELECTOR,
+    RETAINED_SOURCE_PROVIDER,
+)
+from tests.support import (
+    fixtures_test_cached_coding_cli_source_generation_runner as fixture,
+)
+
+
+class RetainedLookupTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.root = Path(temporary.name).resolve()
+        source = self.root / "source"
+        source.mkdir()
+        (source / "main.py").write_text("pass\n")
+        self.retained = RetainedSourceInput.capture(
+            source,
+            component_lock_identity=canonical_identity("lock"),
+            project_authority_identity=canonical_identity("project"),
+            target="host",
+        )
+        self.live = CodingCliSourceGenerator.for_retained_source(self.retained)
+        self.binding = canonical_identity(self.live.selection.to_dict())
+
+    def lookup(self):
+        return CodingCliSourceGenerator.for_accepted_source_lookup(
+            RETAINED_SOURCE_PROVIDER,
+            self.binding,
+            retained_review_identity=self.retained.identity,
+        )
+
+    def test_exact_selection_has_no_model_executable_or_input_path(self):
+        with patch(
+            "literate_ai.adapters.models.coding_cli.select_coding_cli",
+            side_effect=AssertionError("provider discovery forbidden"),
+        ):
+            lookup = self.lookup()
+        self.assertEqual(lookup.selection.to_dict(), self.live.selection.to_dict())
+        self.assertEqual(lookup.selection.tool_binding_identity, self.binding.uri)
+        self.assertFalse(hasattr(lookup.selection, "executable"))
+        self.assertFalse(hasattr(lookup.selection, "retained_source"))
+        with self.assertRaises(CodingCliError) as refused:
+            lookup.generate(None, output_root=self.root / "output")
+        self.assertEqual(refused.exception.code, "coding_cli.accepted_source_only")
+        self.assertFalse((self.root / "output").exists())
+
+    def test_missing_changed_and_foreign_bindings_are_rejected(self):
+        for review, binding in [
+            (None, self.binding),
+            (self.retained.identity, canonical_identity("wrong-binding")),
+            (canonical_identity("wrong-review"), self.binding),
+        ]:
+            with (
+                self.subTest(review=review),
+                self.assertRaises((TypeError, ValueError)),
+            ):
+                AcceptedRetainedSourceSelection(review, binding)
+        with self.assertRaises(ValueError):
+            CodingCliSourceGenerator.for_accepted_source_lookup("unknown", self.binding)
+        with self.assertRaises(ValueError):
+            CodingCliSourceGenerator.for_accepted_source_lookup(
+                "claude", self.binding, retained_review_identity=self.retained.identity
+            )
+        ordinary = CodingCliSourceGenerator.for_accepted_source_lookup(
+            "claude", self.binding
+        )
+        self.assertEqual(ordinary.selection.tool_binding_identity, self.binding.uri)
+
+    def test_live_and_lookup_have_identical_retained_prompt_and_cache_key(self):
+        setup = fixture.CachedCodingCliSourceGenerationRunnerTests()
+        setup.setUp()
+        self.addCleanup(setup.tearDown)
+        keys = []
+        for delegate in (self.live, self.lookup()):
+            cached = CachedCodingCliSourceGenerator.__new__(
+                CachedCodingCliSourceGenerator
+            )
+            cached.selection = delegate.selection
+            cached.delegate = delegate
+            keys.append(
+                cached._key(
+                    setup.node.recipe, setup.execution_plan, setup.stage_request
+                )
+            )
+        self.assertEqual(keys[0], keys[1])
+        key, prompt = keys[0]
+        self.assertEqual(key.request_identity, self.retained.identity)
+        self.assertEqual(key.source_semantics_identity, self.retained.identity)
+        self.assertEqual(
+            key.model_binding.model_selector, RETAINED_SOURCE_NO_MODEL_SELECTOR
+        )
+        self.assertIn('"model_invocations":[]', prompt)
+
+
+class CurrentRetainedBindingTests(unittest.TestCase):
+    """Metadata resolution tests; the export fixture exercises actual CAS trust."""
+
+    def setUp(self):
+        from types import SimpleNamespace
+        from unittest.mock import Mock
+
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name).resolve()
+        self.cache_root = self.root / "accepted-source-cache"
+        self.cache_root.mkdir()
+        self.lock = canonical_identity("current-lock")
+        self.authority = canonical_identity("current-authority")
+        self.cache = Mock()
+        self.cache.cas.get_bytes.side_effect = lambda reference: self.documents[
+            reference
+        ]
+        self.cache.published_entries.return_value = ()
+        self.cache.candidates.side_effect = lambda key, **kw: tuple(
+            entry for entry in self.live if entry.cache_key == key
+        )
+        self.documents = {}
+        self.live = []
+        self.ns = SimpleNamespace
+        self.patch = patch(
+            "literate_ai.adapters.source_materialization.FileSystemSourceCache",
+            return_value=self.cache,
+        )
+        self.patch.start()
+        self.addCleanup(self.patch.stop)
+
+    def entry(
+        self, name="current", *, authority=None, lock=None, target="host", retired=False
+    ):
+        from dataclasses import replace
+
+        from literate_ai.contracts import SourceCacheModelBinding, canonical_json_bytes
+        from tests.support.fixtures_test_source_cache import _cache_key
+        from tests.support.fixtures_test_standard_source_admission import generation
+
+        lock = lock or self.lock
+        authority = authority or self.authority
+        tree = canonical_identity({"tree": name})
+        review = canonical_identity(
+            {
+                "schema": "literate-ai/retained-source-input@1",
+                "origin": RETAINED_SOURCE_PROVIDER,
+                "tree_identity": tree.to_dict(),
+                "component_lock_identity": lock.to_dict(),
+                "project_authority_identity": authority.to_dict(),
+                "target": target,
+            }
+        )
+        selection = {
+            "schema": "literate-ai/retained-source-selection@1",
+            "origin": RETAINED_SOURCE_PROVIDER,
+            "review_identity": review.uri,
+            "generation_provider": None,
+        }
+        key = replace(
+            _cache_key(),
+            request_identity=review,
+            source_semantics_identity=review,
+            coding_cli_tool_binding_identity=canonical_identity(selection),
+            model_binding=SourceCacheModelBinding(
+                RETAINED_SOURCE_PROVIDER, RETAINED_SOURCE_NO_MODEL_SELECTOR
+            ),
+        )
+        provenance = replace(
+            generation().output.provenance,
+            retained_source_identity=review,
+            component_lock_identity=lock,
+            route_decision_identities=(),
+            model_stage_output_identities=(),
+        )
+        reference = name + str(len(self.documents))
+        self.documents[reference] = canonical_json_bytes(provenance.to_dict())
+        entry = self.ns(
+            cache_key=key,
+            provenance_evidence=reference,
+            membership=self.ns(
+                evidence=self.ns(
+                    component_lock_identity=lock, source_tree_identity=tree
+                )
+            ),
+        )
+        self.cache.published_entries.return_value += (entry,)
+        if not retired:
+            self.live.append(entry)
+        return entry
+
+    def resolve(self, **changes):
+        from literate_ai.adapters.source_materialization import (
+            current_accepted_source_bindings,
+        )
+
+        return current_accepted_source_bindings(
+            self.cache_root,
+            **{
+                "component_lock_identity": self.lock,
+                "project_authority_identity": self.authority,
+                "target": "host",
+                **changes,
+            },
+        )
+
+    def test_history_other_target_authority_and_retirement_do_not_choose_a_binding(
+        self,
+    ):
+        self.entry("old-lock", lock=canonical_identity("old-lock"))
+        self.entry("old-authority", authority=canonical_identity("old-authority"))
+        self.entry("other-target", target="other")
+        self.entry("retired", retired=True)
+        current = self.entry()
+        self.assertEqual(
+            self.resolve(),
+            (
+                (
+                    RETAINED_SOURCE_PROVIDER,
+                    current.cache_key.coding_cli_tool_binding_identity,
+                    current.cache_key.request_identity,
+                ),
+            ),
+        )
+        self.assertEqual(self.resolve(target="missing"), ())
+        self.assertEqual(
+            self.resolve(component_lock_identity=canonical_identity("absent")), ()
+        )
+        self.assertEqual(
+            self.resolve(project_authority_identity=canonical_identity("absent")), ()
+        )
+        self.assertTrue(
+            all(
+                call.kwargs["component_lock_identity"] == self.lock
+                for call in self.cache.candidates.call_args_list
+            )
+        )
+
+    def test_ambiguous_current_trees_fail_without_newest_selection(self):
+        from literate_ai.adapters.source_materialization import (
+            SourceMaterializationError,
+            discover_accepted_source_provider_binding,
+        )
+
+        self.entry("one")
+        self.entry("two")
+        with patch(
+            "literate_ai.cache_directories.resolve_cache_directories",
+            return_value=self.ns(build_dir=self.root),
+        ):
+            with self.assertRaises(SourceMaterializationError) as refused:
+                discover_accepted_source_provider_binding(
+                    self.root,
+                    component_lock_identity=self.lock,
+                    project_authority_identity=self.authority,
+                    target="host",
+                )
+        self.assertEqual(
+            refused.exception.code, "execution.accepted_source_provider_ambiguous"
+        )
+
+    def test_inconsistent_namespace_and_changed_binding_fail_closed(self):
+        from dataclasses import replace
+
+        from literate_ai.adapters.source_materialization import (
+            SourceMaterializationError,
+        )
+
+        entry = self.entry()
+        original = entry.cache_key
+        for changes in (
+            {"request_identity": canonical_identity("wrong-review")},
+            {"coding_cli_tool_binding_identity": canonical_identity("wrong-binding")},
+        ):
+            entry.cache_key = replace(original, **changes)
+            with (
+                self.subTest(changes=changes),
+                self.assertRaises(SourceMaterializationError),
+            ):
+                self.resolve()
