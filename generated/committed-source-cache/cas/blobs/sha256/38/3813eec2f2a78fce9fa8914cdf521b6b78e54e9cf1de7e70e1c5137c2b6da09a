OBJECT_ROOT ?= ../_build/objects
OUT ?= ../_build/artifacts
TARGET ?= run.exs
EXPORT_PATH ?= $(OUT)/$(TARGET)
LITAI_LANGUAGE_TOOL ?= elixir
SRCS := main.exs domain.exs store.exs matcher.exs protocol.exs http.exs cli.exs tests/litai_test.exs tools/assemble.exs

.PHONY: all test clean

all: $(SRCS)
	"$(LITAI_LANGUAGE_TOOL)" tools/assemble.exs all "$(OBJECT_ROOT)" "$(OUT)" "$(EXPORT_PATH)"

test: all
	"$(LITAI_LANGUAGE_TOOL)" "$(EXPORT_PATH)" --litai-test

clean: tools/assemble.exs
	"$(LITAI_LANGUAGE_TOOL)" tools/assemble.exs clean "$(OBJECT_ROOT)" "$(OUT)" "$(EXPORT_PATH)"
