    D.optional(cmd,"offset",&D.integer(&1,0,1000000));D.optional(cmd,"limit",&D.integer(&1,1,64));D.optional(cmd,"status",&D.check(&1 in @statuses));D.optional(cmd,"budget",&validate_budget/1);D.optional(cmd,"retry_failed",&D.boolean/1)
