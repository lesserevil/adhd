defmodule Hub.Assemble do
  def run(["assemble", export]) do
    root = Path.expand("..", __DIR__)
    files = Path.wildcard(Path.join(root, "**/*.{ex,exs}")) |> Enum.sort()
    Enum.each(files, fn path -> Code.string_to_quoted!(File.read!(path), file: path) end)
    parts = Enum.map(["hub.ex", "web.ex", "tests/litai_test.exs"], &File.read!(Path.join(root, &1)))
    contents = Enum.join(parts, "\n") <> "\nHub.CLI.main(System.argv())\n"
    Code.string_to_quoted!(contents)
    File.mkdir_p!(Path.dirname(export))
    File.write!(export, contents)
    unless File.regular?(export), do: raise("Export failed")
  end
  def run(["clean" | paths]) do
    root = Path.expand("..", __DIR__)
    Enum.each(paths, fn path ->
      expanded = Path.expand(path)
      if expanded in ["/", Path.dirname(root)] or expanded == root or String.starts_with?(root, expanded <> "/") or String.starts_with?(expanded, root <> "/") do
        raise "Unsafe output directory"
      end
      File.rm_rf!(expanded)
    end)
  end
  def run(_), do: raise("Invalid build invocation")
end
Hub.Assemble.run(System.argv())
