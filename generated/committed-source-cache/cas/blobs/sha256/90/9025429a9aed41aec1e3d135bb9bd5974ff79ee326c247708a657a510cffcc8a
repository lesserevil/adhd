  def apply_command(s, c, a, %{"op" => op} = cmd) when op in ~w(publish publish_record) do
    source = Map.get(cmd, "source", %{"kind" => "agent", "id" => a})

    if source["kind"] == "agent" and source["id"] != a do
      D.fail("FORBIDDEN")
    end

    key = {a, source["kind"], source["id"], source["item_id"]}
    canonical = Map.drop(cmd, ~w(op project_id))

    case (if source["item_id"] do
            s.sources[key]
          else
            nil
          end) do
      %{command: ^canonical, result: r} ->
        {ADHD.Records.reply(s, c, cmd, r), s}

      nil ->
        {id, s} = alloc(s, "publication")
        now = D.now()

        p = %{
          "id" => id,
          "project_id" => c["project_id"],
          "author_id" => a,
          "text" => Map.get(cmd, "text", ""),
          "data" => Map.get(cmd, "data", %{}),
          "created_at" => now,
          "information_type" => Map.get(cmd, "information_type", "message"),
          "source" => source,
          "occurred_at" =>
            if Map.has_key?(cmd, "occurred_at") do
              D.datetime(cmd["occurred_at"])
            else
              now
            end
        }

        s = put_record(s, :publications, p)
        s = ADHD.Records.attach(s, id, cmd)

        subscriptions =
          values(s, :subscriptions)
          |> Enum.filter(fn sub ->
            Map.has_key?(c["agents"], sub["agent_id"]) and not Map.get(sub, "paused", false)
          end)

        {metadata, s} =
          if ADHD.Eventing.config(c)["enabled"] do
            ADHD.Eventing.enqueue(s, c, p, subscriptions)
          else
            next =
              Enum.reduce(subscriptions, s, fn sub, acc ->
                if ADHD.Eventing.selected?(sub, p) do
                  if Map.get(sub, "mode", "filtered") == "raw" do
                    event_delivery(acc, p, sub, %{
                      "subscription_id" => sub["id"],
                      "subscription_revision" => Map.get(sub, "revision", 1),
                      "mode" => "raw"
                    })
                  else
                    event_job(acc, p, sub, c)
                  end
                else
                  acc
                end
              end)

            {nil, next}
          end

        r = %{"publication" => p, "matching" => "pending"}

        r =
          if metadata do
            Map.put(r, "eventing", metadata)
          else
            r
          end

        s =
          if source["item_id"] do
            put_in(s, [:sources, key], %{command: canonical, result: r})
          else
            s
          end

        {ADHD.Records.reply(s, c, cmd, r), s}

      _ ->
        D.fail("SOURCE_CONFLICT")
    end
  end

  def apply_command(s, c, a, %{"op" => "send"} = cmd) do
    recipient = cmd["recipient_id"]

    if not Map.has_key?(c["agents"], recipient) do
