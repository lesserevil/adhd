      :ok = GenServer.call(pid, {:release_move, moves.token}, 30000)
    end

    :ok
  end

  def fail_stop_moves(moves) do
    for {pid, _} <- moves.entries do
      Process.exit(pid, :kill)
    end

    Process.exit(self(), :kill)
  end

  def rename(s, p) do
    %{s | project: p, aliases: Enum.uniq([p | s.aliases])}
  end

  def terminate(_, x) do
    if x.tab do
      :dets.close(x.tab)
    else
      :ok
    end
  end

  def unwrap({:ok, r}) do
    r
  end

  def unwrap({:error, c}) do
    D.fail(c)
  end

  def execute(s, config, actor, mid, c) do
    D.agent(c)

    if not Map.has_key?(config["agents"], actor) do
      D.fail("FORBIDDEN")
    end

    ADHD.Projects.writable(config, c["op"])

    if Map.has_key?(c, "project_id") and c["project_id"] != config["project_id"] and
         c["project_id"] not in s.aliases do
      D.fail("PROJECT_MISMATCH")
    end

    key = {actor, mid}

    if c["op"] in @mutations do
      D.id(mid)

      case s.idempotency[key] do
        nil ->
          {r, n} = apply_command(s, config, actor, c)
          {r, put_in(n, [:idempotency, key], %{command: c, result: r})}

        %{command: ^c, result: result} ->
          {result, s}

        _ ->
          D.fail("IDEMPOTENCY_CONFLICT")
      end
    else
      apply_command(s, config, actor, c)
    end
  end

  defp alloc(s, prefix) do
    D.integer(s.seq, 0, 9_007_199_254_740_990)
    {id, next} = ADHD.Allocator.allocate(s, prefix)
    {id, %{next | seq: s.seq + 1}}
  end

  defp put_record(s, collection, v) do
    put_in(s, [collection, v["id"]], %{seq: s.seq, value: v})
  end

  defp rows(s, k) do
    s[k] |> Map.values() |> Enum.sort_by(& &1.seq)
  end

  defp values(s, k) do
    Enum.map(rows(s, k), & &1.value)
  end

  defp owned(s, k, id, a, field) do
    row = s[k][id] || D.fail("NOT_FOUND")

    if row.value[field] != a do
      D.fail("FORBIDDEN")
    end

    row
  end

  defp project(v, c) do
