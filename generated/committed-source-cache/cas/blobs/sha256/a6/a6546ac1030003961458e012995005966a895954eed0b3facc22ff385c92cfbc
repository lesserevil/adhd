  def acme_authority_sha256, do: @acme_authority_sha256

  defp acme_name(name) do
    if String.starts_with?(name, ["TLS", "ACME"]), do: name, else: "ACME" <> name
  end
  defp acme_refs(value) when is_map(value) do
    Map.new(value, fn
      {"$ref", "#/$defs/" <> name} -> {"$ref", "#/$defs/" <> acme_name(name)}
      {key, item} -> {key, acme_refs(item)}
    end)
  end
  defp acme_refs(value) when is_list(value), do: Enum.map(value, &acme_refs/1)
  defp acme_refs(value), do: value

  # Configuration files admit optional defaulted members; normalized public
  # snapshots remain fully closed. Cross-field requirements still apply.
  defp acme_input(%{"type" => "object", "properties" => props} = value) do
    value |> Map.put("required", [])
      |> Map.put("properties", Map.new(props, fn {key, item} -> {key, acme_input(item)} end))
  end
  defp acme_input(%{"$ref" => "#/$defs/ACMEConfig"}) do
    @acme_authority["$defs"]["ACMEConfig"] |> acme_refs() |> acme_input()
  end
  defp acme_input(value), do: value

  # RFC7396 patches need not be valid complete configurations before merging.
  # Object members are optional and nullable; arrays replace complete arrays.
  defp acme_patch(%{"$ref" => "#/$defs/" <> name}, defs), do: acme_patch(Map.fetch!(defs, name), defs)
  defp acme_patch(%{"type" => "object", "properties" => props}, defs) do
    obj(Map.new(props, fn {key, item} -> {key, %{"anyOf" => [acme_patch(item, defs), %{"type" => "null"}]}} end), [])
  end
  defp acme_patch(value, _defs), do: value

  defp extend_acme(defs) do
    added = Map.new(@acme_authority["$defs"], fn {name, value} -> {acme_name(name), acme_refs(value)} end)
    # Keep integer-token constraints from the existing protocol profile.
    added = acme_integer_tokens(added)
    defs = Map.merge(defs, added)
    input = acme_input(defs["TLSConfig"])
    input = update_in(input, ["allOf", Access.at(0), "then"], &Map.put(&1, "required", ["enabled"]))
    input = update_in(input, ["properties", "acme", "allOf", Access.at(0), "then"], &Map.put(&1, "required", ~w(email domains accept_terms)))
    defs = Map.put(defs, "TLSConfigInput", input)
    defs = Map.put(defs, "TLSMergePatch", acme_patch(defs["TLSConfig"], defs))
    defs = Map.merge(defs, %{
      "admin_tls_status" => ref("TLSStatusCommand"),
      "admin_tls_renew" => ref("TLSRenewCommand"),
      "admin_result_tls_status" => ref("TLSStatus"),
      "admin_result_tls_renew" => ref("TLSRenewResult")
    })
    defs = update_in(defs, ["AdminCommand", "oneOf"], &(&1 ++ Enum.map(~w(tls_status tls_renew), fn name -> ref("admin_" <> name) end)))
    defs = update_in(defs, ["AdminResult", "anyOf"], &(&1 ++ Enum.map(~w(tls_status tls_renew), fn name -> ref("admin_result_" <> name) end)))
    defs = put_in(defs, ["PublicConfig", "properties", "tls"], ref("TLSConfig"))
    defs = put_in(defs, ["MergePatch", "properties", "tls"], %{"anyOf" => [ref("TLSMergePatch"), %{"type" => "null"}]})
    detail = added["TLSRenewUnavailable"]["properties"]["error"]
    condition = %{"if" => %{"properties" => %{"code" => %{"const" => "TLS_RENEW_UNAVAILABLE"}}, "required" => ["code"]}, "then" => detail}
    update_in(defs, ["Error", "properties", "error", "allOf"], &((&1 || []) ++ [condition]))
  end
  defp acme_integer_tokens(value) when is_map(value) do
    value = Map.new(value, fn {key, item} -> {key, acme_integer_tokens(item)} end)
    if value["type"] == "integer", do: Map.put(value, "x-integerToken", true), else: value
  end
  defp acme_integer_tokens(value) when is_list(value), do: Enum.map(value, &acme_integer_tokens/1)
  defp acme_integer_tokens(value), do: value

  defp acme_openapi(paths) do
    token = %{"type" => "string", "minLength" => 22, "maxLength" => 256, "pattern" => "^[A-Za-z0-9_-]+$"}
    operation = %{
      "summary" => "HTTP-01 proof on the separate challenge listener only",
      "description" => "Not served by the private application HTTP listener. Public CA validation requires TCP80 routing to this configured challenge listener. Only current pending domain/token proofs are exposed.",
      "security" => [],
      "parameters" => [%{"name" => "token", "in" => "path", "required" => true, "schema" => token}],
      "responses" => %{
        "200" => %{"description" => "Exact active key authorization", "content" => %{"text/plain" => %{"schema" => %{"type" => "string", "minLength" => 1, "maxLength" => 1024}}}},
        "404" => %{"description" => "Unknown path, Host or inactive token; empty response"},
        "405" => %{"description" => "Only GET is supported; empty response"}
      }
    }
    Map.put(paths, "/.well-known/acme-challenge/{token}", %{
      "x-adhd-listener" => "acme-challenge",
      "servers" => [%{"url" => "http://{challenge_host}:{challenge_port}", "variables" => %{"challenge_host" => %{"default" => "127.0.0.1"}, "challenge_port" => %{"default" => "8080"}}}],
      "get" => operation
    })
  end
