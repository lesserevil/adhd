+"""Portable retained cache rebuild and artifact export without a coding agent."""
+
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import io
+import json
+import os
+import shutil
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from literate_ai.adapters.standard_lifecycle_binding import (
+    resolve_standard_project_lifecycle_driver,
+)
+from literate_ai.cli import main
+from literate_ai.contracts import canonical_identity
+from tests.e2e import test_cli_model_free_rebuild as fixture
+from tests.support.fixtures_retained_native import author_retained_native_fixture
+
+
+@unittest.skipUnless(shutil.which("make") and os.name == "posix", "requires POSIX make")
+class RetainedSourceExportTests(unittest.TestCase):
+    setUp = fixture.ModelFreeRebuildTests.setUp
+    rebuild = fixture.ModelFreeRebuildTests.rebuild
+
+    def build(self):
+        output = io.StringIO()
+        with (
+            patch.dict(os.environ, self.environment),
+            patch(
+                "literate_ai.cli.rebuild.resolve_standard_project_lifecycle_driver",
+                lambda driver: resolve_standard_project_lifecycle_driver(
+                    driver, distribution_observer=lambda: self.distribution
+                ),
+            ),
+            contextlib.redirect_stdout(output),
+            contextlib.redirect_stderr(output),
+        ):
+            status = main(
+                [
+                    "--json",
+                    "build",
+                    "samples/hello-component",
+                    "--project",
+                    str(self.project),
+                    "--from-accepted-source",
+                    "--update-receipt",
+                ]
+            )
+        return status, json.loads(output.getvalue())
+
+    def test_current_retained_membership_exports_with_original_path_unavailable(self):
+        source = self.root / "retained"
+        author_retained_native_fixture(self.project, source)
+        (self.root / "tools/claude").unlink()
+        self.environment["CODING_CLI"] = "unavailable-generation-provider"
+        with patch(
+            "literate_ai.adapters.models.coding_cli.select_coding_cli",
+            side_effect=AssertionError("agent discovery forbidden"),
+        ):
+            status, plan = self.rebuild(
+                "--retained-source", str(source), "--retained-source-plan"
+            )
+            self.assertEqual(status, 0, plan)
+            status, admitted = self.rebuild(
+                "--retained-source",
+                str(source),
+                "--authorize-retained-source",
+                plan["result"]["authorization_identity"],
+            )
+            self.assertEqual(status, 0, admitted)
+            shutil.rmtree(source)
+            with patch(
+                "literate_ai.adapters.models.coding_cli.CodingCliSourceGenerator.generate",
+                side_effect=AssertionError("cache-only export invoked generation"),
+            ):
+                status, exported = self.build()
+            self.assertEqual(status, 0, exported)
+            self.assertTrue(exported["result"]["passed"])
+            artifact = Path(exported["result"]["artifact"])
+            self.assertTrue(artifact.is_file())
+            artifact_digest = hashlib.sha256(artifact.read_bytes()).hexdigest()
+            from literate_ai.adapters.artifact_exports import load_artifact_export
+
+            export = load_artifact_export(
+                self.project,
+                "samples/hello-component",
+            )
+            self.assertEqual(export.artifact_reference.identity.digest, artifact_digest)
+            self.assertTrue(export.accepted_source_only)
+
+            from literate_ai.adapters.cache.filesystem import FileSystemSourceCache
+            from literate_ai.adapters.project_validation import (
+                validated_project_authority_identity,
+            )
+            from literate_ai.adapters.source_materialization import (
