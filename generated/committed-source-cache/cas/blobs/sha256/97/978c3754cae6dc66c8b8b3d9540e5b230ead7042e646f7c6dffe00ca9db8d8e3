  end
  def structural(recipe),do: Map.take(recipe,~w(tokenizer chunk_bytes context_depth context_limit include_context))
  def frozen_case(_s,a,label,group) do
    %{"attempt_id"=>a["value"]["id"],"group_id"=>group["value"]["id"],"cohort"=>label["cohort"],"label"=>label,"evidence_identity"=>a["value"]["evidence_identity"],"snapshot"=>a["value"]["snapshot"],"question_key"=>a["question_key"],"group_keys"=>group["keys"],"owner_id"=>a["value"]["owner_id"]}
  end
  def prepare_cases(s,c,ids,cohort,automatic \\ false) do
    groups=G.build(s.feedback);feedback=Map.put(s.feedback,"cohorts",groups);current_recipe=X.recipe_identity(X.effective(X.resolve(c,s))["recipe"])
    pool=if ids,do: Enum.map(ids,&B.lookup(s,&1)),else: Map.values(s.feedback["attempts"])
    rows=pool |> Enum.sort_by(&{&1["value"]["captured_at"],&1["value"]["id"]},:desc) |> Enum.flat_map(fn a->
      label=B.latest(s,a["value"]["id"]);group=G.find(feedback,a)
      eligible=label != nil and label["cohort"]==cohort and Map.has_key?(c["agents"],a["value"]["owner_id"])
      eligible=eligible and (not automatic or cohort != "training" or a["value"]["recipe_identity"]==current_recipe)
      if eligible,do: [frozen_case(s,a,label,group)],else: if(ids,do: D.fail("MIN_EVIDENCE"),else: [])
    end)
    unique=Enum.uniq_by(rows,& &1["group_id"]);if ids != nil and length(unique) != length(rows),do: D.fail("COHORT_CONFLICT")
    Enum.take(unique,64)
  end
  def signature(c,s,cases,recipes),do: F.digest(%{"base"=>S.base_identity(c),"selection"=>s.retrieval_selection["revision"],"policy"=>policy(c,s),"cases"=>Enum.map(cases,&Map.take(&1,~w(group_id label evidence_identity))),"recipes"=>recipes})
  def prepare_proposal(s,c,cmd,automatic \\ false) do
    if not config(c)["enabled"],do: D.fail("UNAVAILABLE")
    cases=prepare_cases(s,c,cmd["training_attempt_ids"],"training",automatic)
    v=config(c);if length(cases)<v["min_training_groups"],do: D.fail("MIN_EVIDENCE")
    gaps=Enum.count(cases,fn item->
      a=B.lookup(s,item["attempt_id"]);original=B.source_run(s,a);search=original["search"]
      a["value"]["status"]=="completed" and search != nil and search["status"]=="completed" and search["error"]==nil and B.adjudicated(a,item["label"]) in ~w(confirmed_retrieval_gap confirmed_context_assembly_gap)
    end)
    positives=Enum.count(cases,&(&1["label"]["expectation"] in ~w(supported conflicting)))
    if gaps<v["recurrence_groups"] or positives<v["min_positive_training"],do: D.fail("MIN_EVIDENCE")
    baseline=X.effective(X.resolve(c,s))["recipe"];recipes=neighbors(baseline,v["max_variants"])
    %{"cases"=>cases,"recipes"=>recipes,"baseline"=>baseline,"policy"=>policy(c,s),"signature"=>signature(c,s,cases,recipes),"base_identity"=>S.base_identity(c),"selection_revision"=>s.retrieval_selection["revision"]}
  end
  def cases_current?(s,c,cases) do
    feedback=s.feedback
    Enum.all?(cases,fn item->
      a=s.feedback["attempts"][item["attempt_id"]];label=B.latest(s,item["attempt_id"]);group=if a,do: G.find(feedback,a)
      a != nil and Map.has_key?(c["agents"],item["owner_id"]) and label==item["label"] and a["value"]["evidence_identity"]==item["evidence_identity"] and group != nil and group["value"]["id"]==item["group_id"] and group["keys"]==item["group_keys"]
    end)
  end
  def build_zero,do: %{"status"=>"unstarted","indexed"=>0,"total"=>0,"processed"=>0,"reused"=>0,"watermark"=>nil,"native_bytes"=>0,"manifest_identity"=>nil,"error"=>nil}
  def variant(recipe,baseline),do: %{"recipe"=>recipe,"recipe_identity"=>X.recipe_identity(recipe),"changes_index"=>structural(recipe) != structural(baseline),"status"=>"pending","summary"=>nil,"error"=>nil}
  def new(s,c,cmd,p,prepared) do
    if prepared["base_identity"] != S.base_identity(c) or prepared["selection_revision"] != s.retrieval_selection["revision"] or prepared["policy"] != policy(c,s) or not cases_current?(s,c,prepared["cases"]),do: D.fail("CONFIG_CONFLICT")
    existing=s.optimization["signatures"][prepared["signature"]]
    if existing do {%{"proposal"=>public(lookup(s,existing))},s} else
      if not config(c)["enabled"],do: D.fail("UNAVAILABLE")
      if map_size(s.optimization["proposals"])>=config(c)["max_proposals"] or Enum.count(s.optimization["proposals"],fn {_,q}->active?(q) end)>=config(c)["max_active_proposals"],do: D.fail("RESOURCE_EXHAUSTED")
