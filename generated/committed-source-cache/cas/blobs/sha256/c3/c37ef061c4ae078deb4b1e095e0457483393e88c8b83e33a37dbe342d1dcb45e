          valid_record?(current,c,record)->
            event=record["value"];id=event["event_id"];row=current.eventing.events[id]
            # A fetched valid record becomes recoverable downstream work before
            # committing this offset. Fanout stays in ingestion order even when
            # expired earlier records have to be republished at later offsets.
            row=Map.put(row,:broker_observed,true)
