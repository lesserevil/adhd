      p=publication.value;id=p["id"]
      row=events[id] || %{event: %{"schema_version"=>1,"event_id"=>id,"server_id"=>s.server_id,"project_id"=>s.project,"project_sequence"=>publication.seq,"publication_id"=>id,"author_id"=>p["author_id"],"created_at"=>p["created_at"],"publication"=>p},subscriptions: [],state: :materialized,offset: nil,bytes: 0,retry_at: 0,broker_observed: false}
      if byte_size(JSON.encode!(row.event))>262144,do: D.fail("RANGE_TOO_LARGE")
      replay_targets=Map.get(row,:replay_targets,[])++targets
      cost=byte_size(JSON.encode!(row.event))+:erlang.external_size(row.subscriptions)+:erlang.external_size(replay_targets)
      extra=if row.state==:materialized,do: cost,else: max(0,cost-row.bytes)
      row=row |> Map.put(:replay_targets,replay_targets) |> Map.put(:bytes,cost) |> Map.put(:state,:pending) |> Map.put(:offset,nil) |> Map.put(:retry_at,0) |> Map.put(:broker_observed,false)
      {Map.put(events,id,row),bytes+extra}
    end)
    if added>16_777_216,do: D.fail("RANGE_TOO_LARGE")
    pending=Enum.filter(Map.values(events),&(&1.state != :materialized))
    if length(pending)>c["eventing"]["max_pending_events"] or Enum.reduce(pending,0,&(&1.bytes+&2))>c["eventing"]["max_pending_bytes"],do: D.fail("BACKPRESSURE")
    plan=%{"id"=>rid,"status"=>"pending","deferred_filter_targets"=>0,"event_ids"=>Enum.map(selected,& &1.value["id"]),"subscriptions"=>cmd["subscriptions"],"created_at"=>D.now()}
    e=%{s.eventing|events: events,sequence: max(s.eventing.sequence,List.last(selected).seq),replays: Map.put(s.eventing.replays,rid,plan),control_revision: s.eventing.control_revision+1}
    {_,next}=audit(%{s|eventing: e},cmd,actor,"replay")
    {%{"replay"=>plan},next}
  end
  defp complete_replays(s) do
    replays=Map.new(s.eventing.replays,fn {id,plan}->
      {registered,deferred}=Enum.reduce(plan["event_ids"],{true,0},fn event_id,{registered,deferred}->
        row=s.eventing.events[event_id]
        target_positions=target_rows(row) |> Enum.with_index() |> Enum.filter(fn {sub,_}->sub["_replay_id"]==id end)
        ready=Enum.all?(target_positions,fn {_,position}->position<Map.get(row,:filter_registered,0) end)
        count=Enum.count(target_positions,fn {_,position}->position<Map.get(row,:filter_registered,0) and :erlang.band(Map.get(row,:filter_done,0),:erlang.bsl(1,position))==0 end)
        {registered and ready,deferred+count}
      end)
      status=cond do not registered->"pending";deferred>0->"deferred";true->"materialized" end
      {id,plan |> Map.put("status",status) |> Map.put("deferred_filter_targets",deferred)}
    end)
    put_in(s,[:eventing,:replays],replays)
  end
  def freeze(sub,c,previous_adapter \\ nil) do
    adapter=if is_map(c["matcher"]),do: Map.take(c["matcher"],~w(model url timeout_ms retry_ms)),else: previous_adapter
    if mode(sub)=="filtered",do: Map.put(sub,"_filter_policy",%{"threshold_ppm"=>c["threshold_ppm"],"matcher"=>adapter}),else: sub
  end
  def mode(sub),do: Map.get(sub,"mode",if(sub["description"] || sub["filter"],do: "filtered",else: "raw"))
  defp eligible?(sub,p,c,s) do
    Map.has_key?(c["agents"],sub["agent_id"]) and Map.has_key?(s.subscriptions,sub["id"]) and selected?(sub,p)
  end
  def selected?(sub,p) do
      Enum.all?(Map.get(sub,"selectors",%{}),fn {key,values}->
        value=case key do
          "information_type"->p["information_type"]
          "source_kind"->get_in(p,["source","kind"])
          "source_id"->get_in(p,["source","id"])
          "author_id"->p["author_id"]
        end
        value in values
      end)
  end
end
