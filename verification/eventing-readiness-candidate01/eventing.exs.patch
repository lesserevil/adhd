+  defp provision(c,s,apply_retention \\ true,owning_deadline \\ nil) do
+    deadline=provision_deadline(c,owning_deadline)
+    data=request_until(c,:get,"/v3/clusters",nil,@admin,@admin,deadline) |> success()
+    clusters=data["data"];D.check(is_list(clusters) and length(clusters)==1)
+    cluster=hd(clusters)["cluster_id"];D.check(is_binary(cluster))
+    collection="/v3/clusters/"<>URI.encode(cluster,&URI.char_unreserved?/1)<>"/topics"
+    path=collection<>"/"<>URI.encode(topic(c,s),&URI.char_unreserved?/1)
+    {metadata,visibility}=case request_until(c,:get,path,nil,@admin,@admin,deadline) do
+      {status,metadata} when status in 200..299->{metadata,false}
+      {404,_}->
+        body=%{"topic_name"=>topic(c,s),"partitions_count"=>1,"replication_factor"=>1,"configs"=>[%{"name"=>"cleanup.policy","value"=>"delete"},%{"name"=>"retention.ms","value"=>Integer.to_string(c["eventing"]["retention_ms"])}]}
+        case request_until(c,:post,collection,body,@admin,@admin,deadline) do
+          {status,metadata} when status in 200..299->
+            D.check(is_map(metadata) and metadata["partitions_count"]===1)
+            {nil,true}
+          {400,%{"error_code"=>40002}}->{nil,true}
+          _->throw({:eventing,"TOPIC_CREATE_FAILED"})
+        end
+      _->throw({:eventing,"TOPIC_UNAVAILABLE"})
+    end
+    entries=ready_topic(c,path,metadata,visibility,deadline)
+    retention=Enum.find(entries,&(&1["name"]=="retention.ms"))
+    desired=Integer.to_string(c["eventing"]["retention_ms"])
+    if apply_retention and (not is_map(retention) or retention["value"]!=desired) do
+      request_until(c,:post,path<>"/configs:alter",%{"data"=>[%{"name"=>"retention.ms","value"=>desired,"operation"=>"SET"}]},@admin,@admin,deadline) |> success()
+      verified=ready_topic(c,path,nil,false,deadline)
+      current=Enum.find(verified,&(&1["name"]=="retention.ms"))
+      D.check(is_map(current) and current["value"]==desired)
+    end
     :ok
+  end
+  defp ready_topic(c,path,metadata,visibility,deadline) do
+    response=if is_nil(metadata),do: request_until(c,:get,path,nil,@admin,@admin,deadline),else: {200,metadata}
+    case response do
+      {404,_} when visibility->wait_topic(c,path,deadline)
+      {status,metadata} when status in 200..299->
+        D.check(is_map(metadata) and metadata["partitions_count"]===1)
+        case request_until(c,:get,path<>"/configs",nil,@admin,@admin,deadline) do
+          {404,_} when visibility->wait_topic(c,path,deadline)
+          {status,configs} when status in 200..299->
+            D.check(is_map(configs));entries=configs["data"]
+            D.check(is_list(entries) and Enum.all?(entries,&is_map/1))
+            cleanup=Enum.filter(entries,&(&1["name"]=="cleanup.policy"))
+            retention=Enum.filter(entries,&(&1["name"]=="retention.ms"))
+            D.check(length(cleanup)==1 and hd(cleanup)["value"]=="delete")
+            D.check(length(retention)==1 and valid_retention?(hd(retention)["value"]))
+            entries
+          _->throw({:eventing,"BROKER_REQUEST_FAILED"})
+        end
+      _->throw({:eventing,"TOPIC_UNAVAILABLE"})
+    end
+  end
+  defp valid_retention?(value) when is_binary(value) do
+    case Integer.parse(value) do
+      {integer,""}->integer>= -1 and integer<=9223372036854775807 and Integer.to_string(integer)==value
+      _->false
+    end
+  end
+  defp valid_retention?(_),do: false
+  defp wait_topic(c,path,deadline) do
+    Process.sleep(min(50,remaining(deadline)))
+    # Each retry starts a new bounded admission; no HTTP ticket spans this wait.
