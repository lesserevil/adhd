OBJECT_ROOT ?= _build/objects
OUT ?= _build/artifacts
TARGET ?= run
EXPORT_PATH ?= $(OUT)/$(TARGET)
LITAI_LANGUAGE_TOOL ?= elixir
SRCS := domain.exs allocator.exs storage_registry.exs project_backup.exs project_backup_validation.exs recovery_checkpoint.exs recovery_work.exs storage_rebind.exs recovery_coordinator.exs project_restore.exs projects.exs resources.exs records.exs records_protocol.exs history_evaluator.exs history.exs history_protocol.exs retrieval.exs selection.exs retrieval_index.exs retrieval_jobs.exs retrieval_protocol.exs archive_policy.exs archive.exs archive_worker.exs archive_protocol.exs feedback_groups.exs feedback.exs replay.exs replay_worker.exs feedback_protocol.exs optimization.exs optimization_worker.exs optimization_protocol.exs storage.exs directory.exs source_queries.exs directory_protocol.exs multi_protocol.exs project_recovery_protocol.exs protocol.exs eventing.exs federation_v2.exs migration.exs store.exs tls_certificate.exs acme_client.exs tls.exs config.exs identity.exs workers.exs web.exs server.exs cli.exs tests/litai_test.exs main.exs

.PHONY: all test clean
all: $(SRCS) tools/assemble.exs
	"$(LITAI_LANGUAGE_TOOL)" tools/assemble.exs "$(EXPORT_PATH)" "$(OBJECT_ROOT)" "$(OUT)"

test: all
	"$(LITAI_LANGUAGE_TOOL)" "$(EXPORT_PATH)" --litai-test

clean: tools/clean.exs
	"$(LITAI_LANGUAGE_TOOL)" tools/clean.exs "$(OUT)" "$(OBJECT_ROOT)"
