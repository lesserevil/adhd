defmodule Hub.UI do
  def html do
    ~S"""
    <!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ADHD · Coordination workspace</title><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 rx=%276%27 fill=%27%23245ab1%27/%3E%3Cpath d=%27M8 24L16 7l8 17M11 19h10%27 stroke=%27white%27 fill=%27none%27 stroke-width=%272%27/%3E%3C/svg%3E"><link rel="stylesheet" href="/admin/assets/app.css"><script src="/admin/assets/app.js" defer></script></head><body><div id="login"><main class="login"><p class="eyebrow">ADHD / PRIVATE WORKSPACE</p><h1>Coordination hub</h1><p>Sign in to observe published information and manage coordination.</p><form id="login-form"><label for="credential">Administrator token</label><input id="credential" type="password" autocomplete="off" required><button type="submit">Sign in</button></form><p id="login-error" role="alert"></p><details><summary>Access and operations guide</summary><p>Provision distinct agent bearer tokens and a separate administrator token in the operator-owned configuration. Agent tokens need at least 24 characters; the administrator token needs 32–65536 UTF-8 bytes. Restart the service after rotating credentials. Keep the configuration private and access this console through the project's private tunnel. Reloading requires sign-in.</p><p>Only one service process may use a store. The console can view published information and delivery metadata; private addressed message bodies stay available only to their recipient. Subscriptions apply to future publications. Removal cancels pending matching and leaves existing deliveries intact. Retry affects pending jobs only.</p><p>If matching is unavailable, check the configured SystemOne service and its /health endpoint. A healthy probe does not guarantee a relevance result. The hub remains usable during inference outages. Lists show up to 100 rows and mark truncation. Refresh is manual.</p><p>Stop the service before making an offline copy of its DETS file. Back up before upgrading. Schema-1 data upgrades synchronously and retains historical idempotent results. To roll back an older runtime, restore the pre-upgrade offline backup. A corrupt or wrong-project store fails startup and is never reset.</p></details></main></div><div id="workspace" hidden><aside><div class="brand">ADHD<span>Coordination</span></div><nav aria-label="Workspace"><button data-view="Overview">Overview</button><button data-view="Information">Information</button><button data-view="Subscriptions">Subscriptions</button><button data-view="Activity">Activity</button></nav><button id="logout" class="secondary">Sign out</button></aside><main><header><div><p class="eyebrow" id="project"></p><h1 id="title">Overview</h1></div><button id="refresh" class="secondary">Refresh</button></header><p id="status" role="status" aria-live="polite"></p><p id="error" role="alert"></p><p id="checked" class="muted"></p><button id="retry-action" hidden>Retry last uncertain action</button><section id="content" aria-label="Workspace content"></section></main></div></body></html>
    """
  end
  def css do
    ~S"""
    :root{font-family:Avenir,"Segoe UI",sans-serif;color:#17283e;background:#f3f6f9;font-synthesis:none;line-height:1.5}*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button{cursor:pointer;border:1px solid #245ab1;background:#245ab1;color:white;padding:.55rem .9rem;border-radius:5px;font-weight:600}button.secondary{background:white;color:#203d64;border-color:#b6c4d6}button:disabled{opacity:.55;cursor:wait}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #09857d;outline-offset:3px}input,select{padding:.55rem;border:1px solid #9baec3;border-radius:4px;min-width:0;max-width:100%;background:white;color:#17283e}label{font-size:.9rem;font-weight:600;display:flex;flex-direction:column;gap:.3rem}h1{font-size:1.7rem;margin:.1rem 0 1rem;letter-spacing:-.03em}h2{font-size:1.15rem;margin:1.5rem 0 .6rem}p{overflow-wrap:anywhere}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:.87rem;max-width:100%;background:#eef2f7;padding:1rem;border-radius:4px}.eyebrow{font-size:.72rem;font-weight:700;letter-spacing:.13em;color:#60728b;margin:0 0 .3rem}.muted{color:#5c6f84;font-size:.87rem}.login{max-width:540px;padding:2rem;margin:8vh auto}.login form{display:grid;gap:.7rem}.login details{margin-top:2rem;font-size:.9rem}.login details p{color:#4c6078}[hidden]{display:none!important}#workspace{display:grid;grid-template-columns:210px minmax(0,1fr);min-height:100vh}aside{padding:2rem 1rem;background:#e9eef5;border-right:1px solid #d3dde9}.brand{font-size:1.4rem;font-weight:800;padding:0 .7rem 1.6rem}.brand span{display:block;font-size:.78rem;font-weight:500;color:#60728b}nav{display:grid;gap:.3rem;margin-bottom:2rem}nav button{text-align:left;background:transparent;border-color:transparent;color:#40566f}nav button[aria-current=page]{color:#164b9e;background:#d9e7fb;border-color:#bfcef0}#workspace main{padding:2rem 3rem;max-width:1400px;width:100%;min-width:0}header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}#error,#login-error{color:#a33125}#status{color:#235660}.healthy{color:#087366;font-weight:650}.pending{color:#986209;font-weight:650}.counts{display:grid;grid-template-columns:minmax(0,1fr) auto;max-width:650px;margin:0}.counts dt,.counts dd{margin:0;padding:.55rem .25rem;border-bottom:1px solid #d6e0ea}.counts dd{font-variant-numeric:tabular-nums;font-weight:650}.toolbar{display:flex;gap:.7rem;flex-wrap:wrap;align-items:end;margin:1rem 0}.toolbar label{flex:1 1 140px}.toolbar button{flex:0 0 auto}.region{overflow-x:auto;border:1px solid #d3dde9;background:white;border-radius:5px;max-width:100%;margin:1rem 0}table{border-collapse:collapse;width:100%;font-size:.9rem;text-align:left}td,th{padding:.7rem .8rem;vertical-align:top;border-bottom:1px solid #e0e6ed;overflow-wrap:anywhere;max-width:380px}th{font-size:.75rem;color:#5a6e85;letter-spacing:.03em;background:#f7f9fc}td button{font-size:.8rem}.description{white-space:pre-wrap;overflow-wrap:anywhere}#detail{padding:1rem;border-left:3px solid #3a74bf;background:white;margin-top:1rem}.empty{padding:1rem;color:#61748a;border-top:1px solid #cbd7e4}@media(max-width:700px){#workspace{display:block}aside{padding:.7rem 1rem;border-right:0;border-bottom:1px solid #d3dde9}.brand{font-size:1rem;padding:0}.brand span{display:none}nav{display:flex;gap:.1rem;overflow-x:auto;margin:.5rem 0}nav button{padding:.45rem .5rem;font-size:.8rem}#logout{font-size:.75rem;padding:.3rem .6rem}#workspace main{padding:1.2rem 1rem}.login{padding:1.2rem;margin:3vh auto}h1{font-size:1.5rem}.toolbar label{flex-basis:100%}td,th{max-width:220px;min-width:100px}.counts{width:100%}}
    """
  end
  def js do
    ~S"""
    'use strict';
    (()=>{
    let bearer='',view='Overview',generation=0,agents=[],pending=null,busy=false,filters={};
    const $=id=>document.getElementById(id);
    const node=(tag,text,cls)=>{const n=document.createElement(tag);if(text!==undefined)n.textContent=String(text);if(cls)n.className=cls;return n;};
    function clear(){generation++;bearer='';agents=[];pending=null;busy=false;filters={};$('credential').value='';$('workspace').hidden=true;$('login').hidden=false;$('content').replaceChildren();for(const id of ['error','status','checked','project','login-error'])$(id).textContent='';$('retry-action').hidden=true;}
    function loginRequired(){clear();$('login-error').textContent='Sign in again to continue.';}
    async function api(command){
      const response=await fetch('/admin/api',{method:'POST',cache:'no-store',headers:{'Content-Type':'application/json','Authorization':'Bearer '+bearer},body:JSON.stringify(command)});
      if(response.status===401){loginRequired();throw Error('Sign in again to continue.');}
      if(!response.ok)throw Error(response.status===409?'This request conflicts with an earlier action.':response.status===404?'The requested record or administrator API is unavailable.':'The request could not be completed.');
      return response.json();
    }
    function table(parent,headers,rows){
      if(!rows.length){parent.append(node('p','No records found.','empty'));return;}
      const region=node('div',undefined,'region');region.setAttribute('role','region');region.setAttribute('aria-label',headers.join(', '));region.tabIndex=0;
      const t=node('table'),head=node('thead'),tr=node('tr');headers.forEach(h=>{const th=node('th',h);th.scope='col';tr.append(th);});head.append(tr);t.append(head);const body=node('tbody');
      rows.forEach(row=>{const tr=node('tr');row.forEach(v=>{const td=node('td');if(v instanceof Node)td.append(v);else td.textContent=String(v??'');tr.append(td);});body.append(tr);});t.append(body);region.append(t);parent.append(region);
    }
    function button(label,action){const b=node('button',label);b.type='button';b.disabled=busy;b.addEventListener('click',action);return b;}
    function field(form,label,name,value=''){const l=node('label',label),i=node('input');i.name=name;i.value=value;l.append(i);form.append(l);return i;}
    function limited(parent,result){if(result.truncated)parent.append(node('p','More records exist. Refine filters to narrow the list.','pending'));}
    function mutationControls(disabled){document.querySelectorAll('[data-mutation]').forEach(b=>b.disabled=disabled);$('retry-action').disabled=disabled;}
    async function mutate(command){
      if(pending&&!command.message_id){const prior={...pending};delete prior.message_id;if(JSON.stringify(prior)!==JSON.stringify(command)){$('error').textContent='Retry the uncertain action before starting another mutation.';return;}command=pending;}
      if(busy)return;busy=true;mutationControls(true);$('error').textContent='';$('status').textContent='Saving…';
      if(!command.message_id)command.message_id=crypto.randomUUID();pending=command;
      try{await api(command);pending=null;$('retry-action').hidden=true;$('status').textContent='Saved.';await refresh();}
      catch(e){if(bearer){$('error').textContent=e.message+' Retry preserves the same request identifier.';$('retry-action').hidden=false;}}
      finally{busy=false;mutationControls(false);if(bearer)$('status').textContent='';}
    }
    async function detail(id,parent,epoch){try{const r=await api({op:'publication',publication_id:id});if(epoch!==generation||!bearer)return;let panel=$('detail');if(!panel){panel=node('section');panel.id='detail';panel.setAttribute('aria-label','Publication details');parent.append(panel);}panel.replaceChildren(node('h2','Publication details'),node('pre',JSON.stringify(r.publication,null,2)));panel.tabIndex=-1;panel.focus();}catch(e){if(epoch===generation)$('error').textContent=e.message;}}
    async function render(parent,epoch){
      if(view==='Overview'){
        const r=await api({op:'overview'});if(epoch!==generation)return;
        agents=r.agents;$('project').textContent=r.project_id;
        parent.append(node('p','Service reachable · authenticated administrator','healthy'));
        const dl=node('dl',undefined,'counts');Object.entries(r.counts).forEach(([k,v])=>dl.append(node('dt',k.replaceAll('_',' ')),node('dd',v)));parent.append(dl,node('h2','Agents'));
        table(parent,['Agent','Subscriptions','Queued deliveries'],r.agents.map(a=>[a.agent_id,a.subscriptions,a.queued_deliveries]));
        parent.append(node('h2','Matcher'),node('p',r.matcher.status,r.matcher.status==='ready'?'healthy':'pending'),node('p','Observed '+r.matcher.checked_at+' · Model '+r.matcher.model,'muted'),node('p','Health is a reachability observation; classifications can still fail.','muted'));
      }else if(view==='Information'){
        const form=node('form',undefined,'toolbar');for(const [name,label]of [['query','Search text'],['information_type','Information type'],['source_kind','Source kind'],['source_id','Source ID']])field(form,label,name,filters[name]||'');
        const submit=node('button','Search');submit.type='submit';form.append(submit);form.addEventListener('submit',e=>{e.preventDefault();filters={};new FormData(form).forEach((v,k)=>{if(v)filters[k]=v;});refresh();});parent.append(form);
        const r=await api({op:'publications',...filters,limit:100});if(epoch!==generation)return;
        table(parent,['Type / time','Author / source','Published text','Details'],r.items.map(p=>[p.information_type+' · '+p.created_at,p.author_id+' / '+p.source.kind+': '+p.source.id,p.text,button('Open '+p.id,()=>detail(p.id,parent,epoch))]));limited(parent,r);
      }else if(view==='Subscriptions'){
        const [r,o]=await Promise.all([api({op:'subscriptions',limit:100}),api({op:'overview'})]);if(epoch!==generation)return;agents=o.agents;
        const f=node('form',undefined,'toolbar'),label=node('label','Owner agent'),select=node('select');select.name='agent_id';agents.forEach(a=>{const x=node('option',a.agent_id);x.value=a.agent_id;select.append(x);});label.append(select);f.append(label);const desc=field(f,'Subscription description','description');desc.required=true;const add=node('button','Create subscription');add.type='submit';add.dataset.mutation='true';add.disabled=busy;f.append(add);f.addEventListener('submit',e=>{e.preventDefault();mutate({op:'create_subscription',agent_id:select.value,description:desc.value});});parent.append(f);
        table(parent,['Owner','Description','Created','Action'],r.items.map(s=>{const b=button('Remove',()=>{if(confirm('Remove subscription owned by '+s.agent_id+'?\n\n'+s.description))mutate({op:'remove_subscription',subscription_id:s.id,confirm:true});});b.dataset.mutation='true';return[s.agent_id,node('div',s.description,'description'),s.created_at,b];}));limited(parent,r);
      }else{
        const [ds,js]=await Promise.all([api({op:'deliveries',limit:100}),api({op:'jobs',limit:100})]);if(epoch!==generation)return;
        parent.append(node('h2','Delivery metadata'),node('p','Private addressed message content is never available here.','muted'));
        table(parent,['Delivery','Recipient','Kind','Created','Acknowledged','Publication'],ds.items.map(d=>[d.delivery_id,d.recipient_id,d.kind,d.created_at,d.acknowledged?'Yes':'No',d.publication_id||'—']));limited(parent,ds);
        parent.append(node('h2','Matching jobs'));const b=button('Retry pending jobs',()=>{if(confirm('Retry all pending matching jobs now? Completed and cancelled jobs remain unchanged.'))mutate({op:'retry_jobs',confirm:true});});b.dataset.mutation='true';parent.append(b);
        table(parent,['Job','Publication','Subscription','Recipient','Status','Retry at'],js.items.map(j=>[j.job_id,j.publication_id,j.subscription_id,j.recipient_id,j.status,j.retry_at]));limited(parent,js);
      }
    }
    async function refresh(){if(!bearer)return;const epoch=++generation;$('title').textContent=view;$('content').replaceChildren();$('error').textContent='';$('status').textContent='Loading…';document.querySelectorAll('[data-view]').forEach(b=>{if(b.dataset.view===view)b.setAttribute('aria-current','page');else b.removeAttribute('aria-current');});const parent=node('div');$('content').append(parent);try{await render(parent,epoch);if(epoch!==generation)return;$('checked').textContent='Last checked '+new Date().toLocaleString();$('status').textContent='';}catch(e){if(epoch===generation&&bearer){parent.replaceChildren(node('p','Unable to load records. Use Refresh to retry.','empty'));$('error').textContent=e.message;$('status').textContent='';}}}
    $('login-form').addEventListener('submit',async e=>{e.preventDefault();bearer=$('credential').value;$('credential').value='';const b=e.target.querySelector('button');b.disabled=true;$('login-error').textContent='Signing in…';try{const o=await api({op:'overview'});agents=o.agents;$('project').textContent=o.project_id;$('login').hidden=true;$('workspace').hidden=false;$('login-error').textContent='';view='Overview';await refresh();}catch(e){bearer='';$('login-error').textContent=e.message;}finally{b.disabled=false;}});
    $('logout').addEventListener('click',clear);$('refresh').addEventListener('click',refresh);$('retry-action').addEventListener('click',()=>{if(pending)mutate(pending);});document.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>{view=b.dataset.view;refresh();}));
    })();
    """
  end
end
