if System.argv() == ["--litai-test"] do
  IO.puts(JSON.encode!(ADHD.Tests.run()))
  System.halt(0)
end

try do
  result = case System.argv() do
    ["--litai-test"] -> ADHD.Tests.run()
    ["--litai-smoke"] -> ADHD.Tests.smoke()
    [value] ->
      case ADHD.JSON.decode!(value) do
        args when is_list(args) -> ADHD.CLI.run(args)
        _ -> ADHD.Domain.fail()
      end
    _ -> ADHD.Domain.fail()
  end
  if result != :serving, do: IO.puts(JSON.encode!(result))
rescue
  _ -> IO.puts(:stderr, "Invalid request or service unavailable"); System.halt(1)
catch
  _, _ -> IO.puts(:stderr, "Invalid request or service unavailable"); System.halt(1)
end
