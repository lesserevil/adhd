+// ADHD's fixed error-only process protocol. No CA URLs, account IDs or raw errors.
+package cmd
+
+import (
+	"encoding/json"
+	"errors"
+	"github.com/go-acme/lego/v5/cmd/internal"
+	"io"
+)
+
+func WriteACMEResult(err error, writer io.Writer) {
+	if err == nil {
+		return
+	}
+	result := struct {
+		Code    string `json:"code"`
+		RetryAt *int64 `json:"retry_at"`
+	}{Code: "ACME_PROCESS"}
+	var rate *internal.ACMERateLimitError
+	if errors.As(err, &rate) {
+		result.Code = "ACME_RATE_LIMIT"
+		result.RetryAt = rate.RetryAt
+	}
+	payload, marshalErr := json.Marshal(result)
+	if marshalErr != nil {
+		return
+	}
+	_, _ = io.WriteString(writer, "ADHD_ACME_RESULT "+string(payload)+"\n")
+}
