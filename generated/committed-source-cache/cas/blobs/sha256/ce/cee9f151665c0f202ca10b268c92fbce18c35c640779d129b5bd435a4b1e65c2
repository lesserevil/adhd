  def js do
    ~S"""
    'use strict';
    (()=>{
    let token='',view='Overview',revision=0,busy=false,uncertain=null,agents=[],lastFilters={};
    const $=id=>document.getElementById(id), content=$('content');
    const node=(tag,text,cls)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=text;if(cls)e.className=cls;return e;};
    const button=(text,fn)=>{const b=node('button',text);b.type='button';b.addEventListener('click',fn);return b;};
    function logout(){token='';uncertain=null;revision++;agents=[];lastFilters={};content.replaceChildren();$('project').textContent='';$('state').textContent='';$('error').textContent='';$('login-error').textContent='';$('guide').hidden=true;$('console').hidden=true;$('login').hidden=false;$('token').value='';}
    async function api(command){let r;try{r=await fetch('/admin/api',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},body:JSON.stringify(command)});}catch(e){throw new Error('Service could not be reached. Retry when the connection is available.');}if(r.status===401){logout();$('login-error').textContent='Sign in with a valid administrator token.';throw new Error('Sign in with a valid administrator token.');}if(!r.ok){throw new Error(r.status===409?'This request identifier has already been used for another action.':'Request could not be completed. Check the fields and retry.');}return await r.json();}
    function field(form,label,name,type='text',value=''){const id='field-'+name;const l=node('label',label);l.htmlFor=id;const e=node(type==='textarea'?'textarea':'input');if(type!=='textarea')e.type=type;e.id=id;e.name=name;e.value=value;form.append(l,e);return e;}
    function select(form,label,name,options){const l=node('label',label);l.htmlFor='field-'+name;const e=node('select');e.id=l.htmlFor;e.name=name;options.forEach(o=>{const v=node('option',o.label||o);v.value=o.value===undefined?o:o.value;e.append(v);});form.append(l,e);return e;}
    function empty(text='No matching records.'){content.append(node('p',text,'empty'));}
    function trunc(r){if(r.truncated)content.append(node('p','More records are available. Refine filters to narrow the list.','pending'));}
    function table(title,heads,rows){content.append(node('h2',title));const region=node('div',undefined,'table-region');region.tabIndex=0;region.setAttribute('role','region');region.setAttribute('aria-label',title);const t=node('table'),tr=node('tr');heads.forEach(h=>{const th=node('th',h);th.scope='col';tr.append(th);});const thead=node('thead');thead.append(tr);t.append(thead);const tb=node('tbody');rows.forEach(row=>{const r=node('tr');row.forEach(v=>r.append(node('td',String(v))));tb.append(r);});t.append(tb);region.append(t);content.append(region);if(!rows.length)empty('No '+title.toLowerCase()+' yet.');}
    function rows(items,render){if(!items.length)empty();items.forEach(render);}
    async function mutate(command){if(busy)return;const serialized=JSON.stringify(command);if(uncertain&&uncertain.serialized!==serialized){$('error').textContent='Retry the pending action or log out before starting a different mutation.';return;}if(!uncertain)uncertain={serialized,command:{...command,message_id:crypto.randomUUID?crypto.randomUUID():String(Date.now())+'-'+String(Math.random()).slice(2)}};busy=true;document.querySelectorAll('button[type=submit],button[data-mutation]').forEach(b=>b.disabled=true);try{await api(uncertain.command);uncertain=null;await refresh();}catch(e){$('error').textContent=e.message+' The action identifier is preserved for retry.';const retry=button('Retry pending action',()=>mutate(command));retry.dataset.mutation='true';content.append(retry);}finally{busy=false;document.querySelectorAll('button[type=submit],button[data-mutation]').forEach(b=>b.disabled=false);}}
    function overview(r){$('project').textContent=r.project_id;content.append(node('h2','Service reachable','healthy'));content.append(node('p','Matcher '+r.matcher.status+' · '+r.matcher.model+' · observed '+r.matcher.checked_at,r.matcher.status==='ready'?'healthy':'pending'));Object.entries(r.counts).forEach(([k,v])=>{const row=node('div',undefined,'row');row.append(node('span',k.replaceAll('_',' ')),node('span',String(v),'count'));content.append(row);});table('Agents',['Agent','Subscriptions','Queued deliveries'],r.agents.map(a=>[a.agent_id,a.subscriptions,a.queued_deliveries]));}
    function information(r,filter){const form=node('form',undefined,'filters');field(form,'Text search','query','text',filter.query||'');field(form,'Information type','information_type','text',filter.information_type||'');field(form,'Source kind','source_kind','text',filter.source_kind||'');field(form,'Source ID','source_id','text',filter.source_id||'');const submit=node('button','Search');submit.type='submit';form.append(submit);form.addEventListener('submit',e=>{e.preventDefault();lastFilters={};new FormData(form).forEach((v,k)=>{if(v!=='')lastFilters[k]=v;});refresh();});content.append(form);rows(r.items,p=>{const row=node('div',undefined,'row'),box=node('div');box.append(node('strong',p.information_type+' · '+p.source.kind+': '+p.source.id),node('p',p.text||JSON.stringify(p.data)),node('p',p.created_at+' · '+p.author_id,'muted'));row.append(box,button('Details',async()=>{const ticket=revision;try{const result=await api({op:'publication',publication_id:p.id});if(ticket!==revision)return;let d=$('detail');if(d)d.remove();d=node('section');d.id='detail';d.append(node('h2','Publication details'),node('pre',JSON.stringify(result.publication,null,2)));content.append(d);d.scrollIntoView({block:'nearest'});}catch(e){$('error').textContent=e.message;}}));content.append(row);});trunc(r);}
    function subscriptions(r){content.append(node('h2','Create subscription'));const form=node('form');const owner=select(form,'Owner agent','agent_id',agents);const desc=field(form,'Plain-text description','description','textarea');desc.required=true;desc.maxLength=4096;const submit=node('button','Create subscription');submit.type='submit';form.append(submit);form.addEventListener('submit',e=>{e.preventDefault();mutate({op:'create_subscription',agent_id:owner.value,description:desc.value});});content.append(form,node('h2','Subscriptions'));rows(r.items,s=>{const row=node('div',undefined,'row'),box=node('div');box.append(node('strong',s.agent_id),node('p',s.description),node('p',s.created_at,'muted'));const b=button('Remove',()=>{if(window.confirm('Remove subscription owned by '+s.agent_id+'?\n\n'+s.description))mutate({op:'remove_subscription',subscription_id:s.id,confirm:true});});b.dataset.mutation='true';row.append(box,b);content.append(row);});trunc(r);}
    function activity(ds,js){const b=button('Retry pending jobs',()=>{if(window.confirm('Retry all pending matching jobs now? Completed and cancelled jobs remain unchanged.'))mutate({op:'retry_jobs',confirm:true});});b.dataset.mutation='true';content.append(b);table('Delivery metadata',['Delivery','Recipient','Kind','Created','Acknowledged','Publication'],ds.items.map(d=>[d.delivery_id,d.recipient_id,d.kind,d.created_at,d.acknowledged,d.publication_id||'—']));trunc(ds);table('Matching jobs',['Job','Publication','Subscription','Recipient','Status','Retry at (epoch ms)'],js.items.map(j=>[j.job_id,j.publication_id,j.subscription_id,j.recipient_id,j.status,j.retry_at]));trunc(js);}
    async function refresh(){if(!token)return;const ticket=++revision,selected=view;const filter={...lastFilters};$('state').textContent='Loading…';$('error').textContent='';$('view-title').textContent=view;document.querySelectorAll('[data-view]').forEach(b=>{if(b.dataset.view===view)b.setAttribute('aria-current','page');else b.removeAttribute('aria-current');});try{let result;if(view==='Overview')result=await api({op:'overview'});if(view==='Information')result=await api({op:'publications',...filter});if(view==='Subscriptions'){const all=await Promise.all([api({op:'subscriptions'}),api({op:'overview'})]);result=all[0];agents=all[1].agents.map(a=>a.agent_id);}if(view==='Activity')result=await Promise.all([api({op:'deliveries'}),api({op:'jobs'})]);if(ticket!==revision||selected!==view||!token)return;content.replaceChildren();if(view==='Overview')overview(result);if(view==='Information')information(result,filter);if(view==='Subscriptions')subscriptions(result);if(view==='Activity')activity(...result);$('state').textContent='Last checked '+new Date().toLocaleString();}catch(e){if(ticket===revision){$('state').textContent='Unable to load this view.';$('error').textContent=e.message;}}}
    $('login-form').addEventListener('submit',async e=>{e.preventDefault();token=$('token').value;$('token').value='';$('login-error').textContent='';const b=e.target.querySelector('button');b.disabled=true;try{const r=await api({op:'overview'});$('login').hidden=true;$('console').hidden=false;view='Overview';$('view-title').textContent=view;content.replaceChildren();overview(r);$('state').textContent='Last checked '+new Date().toLocaleString();}catch(err){token='';$('login-error').textContent=err.message;}finally{b.disabled=false;}});
    document.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>{view=b.dataset.view;refresh();}));$('refresh').addEventListener('click',refresh);$('logout').addEventListener('click',logout);$('help-toggle').addEventListener('click',()=>{$('guide').hidden=!$('guide').hidden;});
    })();
    """
  end
end

