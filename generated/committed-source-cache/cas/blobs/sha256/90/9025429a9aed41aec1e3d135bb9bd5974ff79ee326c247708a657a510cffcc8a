  def apply_command(s, c, a, %{"op" => "subscribe"} = cmd) do
    mode =
      Map.get(
        cmd,
        "mode",
        if Map.has_key?(cmd, "filter") or Map.has_key?(cmd, "description") do
          "filtered"
        else
          "raw"
        end
      )

    if mode == "filtered" and is_nil(c["matcher"]) do
      D.fail("MODEL_UNAVAILABLE")
    end

    s =
      if mode == "filtered" do
        ADHD.Eventing.remember_adapter(s, c)
      else
        s
      end

    activation = s.seq
    {id, s} = alloc(s, "subscription")

    v = %{
      "id" => id,
      "agent_id" => a,
      "project_id" => c["project_id"],
      "mode" => mode,
      "selectors" => Map.get(cmd, "selectors", %{}),
      "revision" => 1,
      "paused" => false,
      "activation_sequence" => activation,
      "created_at" => D.now()
    }

    criterion = cmd["filter"] || cmd["description"]

    v =
      if mode == "filtered" do
        v |> Map.put("filter", criterion) |> Map.put("description", criterion)
      else
        v
      end

    {%{"subscription" => v}, put_record(s, :subscriptions, v)}
  end

  def apply_command(s, c, a, %{"op" => "update_subscription"} = cmd) do
    row = owned(s, :subscriptions, cmd["subscription_id"], a, "agent_id")

    if Map.get(row.value, "revision", 1) != cmd["expected_revision"] do
      D.fail("CONFIG_CONFLICT")
    end

    mode =
      Map.get(
        cmd,
        "mode",
        if Map.has_key?(cmd, "filter") or Map.has_key?(cmd, "description") do
          "filtered"
        else
          "raw"
        end
      )

    if mode == "filtered" and is_nil(c["matcher"]) do
      D.fail("MODEL_UNAVAILABLE")
    end

    s =
      if mode == "filtered" do
        ADHD.Eventing.remember_adapter(s, c)
      else
        s
      end

    value =
      row.value
      |> Map.drop(~w(filter description))
      |> Map.merge(%{
        "mode" => mode,
        "selectors" => Map.get(cmd, "selectors", %{}),
        "revision" => Map.get(row.value, "revision", 1) + 1,
        "paused" => Map.get(cmd, "paused", false),
        "activation_sequence" => s.seq
      })

    value =
      if mode == "filtered" do
        value
        |> Map.put("filter", cmd["filter"] || cmd["description"])
        |> Map.put("description", cmd["filter"] || cmd["description"])
      else
        value
      end

    {%{"subscription" => value}, put_in(s, [:subscriptions, value["id"], :value], value)}
  end

  def apply_command(s, c, a, %{"op" => "list_subscriptions"}) do
