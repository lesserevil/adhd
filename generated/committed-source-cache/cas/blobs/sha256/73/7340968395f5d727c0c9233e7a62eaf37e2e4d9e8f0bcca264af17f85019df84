    equal(O.patch(%{"max_proposals"=>1}),:ok)
    rejects(fn->D.admin(%{"op"=>"index_proposals","status"=>"not-a-status"}) end)
    rejects(fn->D.admin(%{"op"=>"propose_index","message_id"=>"m","expected_revision"=>1,"confirm"=>true,"requester_kind"=>"optimization"}) end)
    rejects(fn->D.agent(%{"op"=>"replay_retrieval","attempt_id"=>"a","candidate_recipe"=>%{},"requester_id"=>"forged"}) end)
