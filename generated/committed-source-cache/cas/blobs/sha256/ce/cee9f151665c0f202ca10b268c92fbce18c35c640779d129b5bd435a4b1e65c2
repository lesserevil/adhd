  def css do
    ~S"""
    :root{font-family:Avenir,"Segoe UI",sans-serif;color:#122b42;background:#f2f5f8;font-size:15px}*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button{cursor:pointer;border:1px solid #b9c8d5;background:white;color:#123e67;border-radius:5px;padding:.65rem .9rem;min-height:42px}button:hover{background:#e7eff7}button:disabled{opacity:.55;cursor:wait}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #137bb7;outline-offset:2px}input,select,textarea{width:100%;min-width:0;padding:.7rem;border:1px solid #a6b7c7;border-radius:4px;background:white;color:#122b42}label{display:block;font-weight:600;margin:.6rem 0 .35rem}h1{font-size:1.7rem;line-height:1.25;margin:.3rem 0 1rem;overflow-wrap:break-word}h2{font-size:1.15rem;margin:1.7rem 0 .7rem}p{line-height:1.6;overflow-wrap:anywhere}.eyebrow{font-size:.78rem;letter-spacing:.09em;color:#52677a}.subtitle{font-size:.84rem;max-width:180px;margin-bottom:2rem}#login{max-width:520px;margin:12vh auto;padding:2rem}#login button{margin-top:1rem;background:#174f82;color:white}#console{display:grid;grid-template-columns:230px minmax(0,1fr);min-height:100vh}#console[hidden],[hidden]{display:none!important}aside{background:#e6edf3;border-right:1px solid #cfdbe4;padding:2rem 1.3rem}.brand{font-size:1.7rem;font-weight:800}nav{display:flex;flex-direction:column;gap:.4rem;margin-bottom:2rem}nav button{text-align:left;border-color:transparent;background:transparent}nav button[aria-current=page]{background:#d1e4f6;color:#124c80;font-weight:700}.workspace{padding:2rem 3rem;min-width:0;max-width:1400px}header{display:flex;justify-content:space-between;align-items:center;gap:1rem}#state{color:#426270;font-size:.9rem}#error,#login-error{color:#9b281f}.row{border-bottom:1px solid #d5dfe7;padding:1rem 0;display:flex;gap:1rem;justify-content:space-between;align-items:flex-start;min-width:0}.row>div{min-width:0}.row p{margin:.3rem 0;white-space:pre-wrap}.muted{color:#52677a;font-size:.88rem}.count{font-size:1.55rem;font-weight:700;font-variant-numeric:tabular-nums}.healthy{color:#086c61}.pending{color:#8b5800}.filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem 1rem;margin-bottom:1rem}.filters button{align-self:end}form{max-width:760px}pre{white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;background:#e8eef3;padding:1rem;line-height:1.5;font-size:.85rem}#detail{border-top:2px solid #b5c7d7;margin-top:1rem;padding-top:1rem}table{border-collapse:collapse;width:100%;font-size:.9rem}td,th{text-align:left;padding:.8rem .7rem;border-bottom:1px solid #d4dfe7;vertical-align:top;overflow-wrap:anywhere}th{font-size:.8rem;color:#52677a}.table-region{overflow-x:auto;max-width:100%}.table-region table{min-width:600px}.actions{display:flex;gap:.5rem;flex-wrap:wrap}.empty{color:#52677a;padding:1.5rem 0}#guide{border-top:1px solid #b4c7d4;margin-top:2rem}aside>button{display:block;margin-top:.6rem}#content{min-width:0}@media(max-width:700px){#login{margin:6vh auto;padding:1.3rem}#console{display:block}aside{padding:1rem;border-right:0;border-bottom:1px solid #cfdbe4}.brand{font-size:1.35rem}.subtitle{max-width:none;margin:.4rem 0 .8rem}nav{flex-direction:row;overflow-x:auto;gap:.2rem;margin:0 0 .7rem}nav button{padding:.55rem;font-size:.85rem;white-space:nowrap}aside>button{display:inline-block;margin:0 .4rem 0 0}.workspace{padding:1.2rem}h1{font-size:1.45rem}.filters{grid-template-columns:minmax(0,1fr)}.row{gap:.5rem}.row button{flex-shrink:0;padding:.6rem}.count{font-size:1.3rem}}
