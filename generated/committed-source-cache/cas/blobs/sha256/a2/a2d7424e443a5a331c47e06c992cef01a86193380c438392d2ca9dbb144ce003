  def css do
    ~S"""
    :root{font-family:Avenir,"Segoe UI",sans-serif;color:#172c45;background:#f2f5f8;font-size:16px}*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button{cursor:pointer;border:1px solid #1c5bb4;background:#1c5bb4;color:white;border-radius:5px;padding:.6rem .85rem;min-height:42px}button.secondary{background:white;color:#23496c;border-color:#b4c3d3}button.danger{background:#fff;color:#9a2d28;border-color:#ca8580}button:disabled{opacity:.55;cursor:wait}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #167ab9;outline-offset:3px}input,select{border:1px solid #8a9fb4;border-radius:4px;padding:.6rem;max-width:100%;min-width:0;background:white;color:#172c45}label{display:block;font-size:.9rem;font-weight:600;margin-bottom:.4rem}h1{font-size:1.8rem;line-height:1.25;margin:.3rem 0 1rem;overflow-wrap:break-word}h2{font-size:1.2rem}p{line-height:1.5}a{color:#1656a2}[hidden]{display:none!important}.login{max-width:500px;margin:10vh auto;padding:2rem;background:#fff;border:1px solid #d6dfe8;border-radius:8px}.login form{display:grid;gap:.65rem}.eyebrow{font-size:.8rem;text-transform:uppercase;letter-spacing:.08em;color:#52677f}.brand{font-size:1.7rem;font-weight:800;letter-spacing:.06em}.subtitle{font-size:.8rem;color:#496078;line-height:1.5;max-width:190px}#console{display:grid;grid-template-columns:225px minmax(0,1fr);min-height:100vh}aside{background:#e8eef5;padding:1.5rem 1rem;border-right:1px solid #cbd7e3}nav{display:grid;gap:.4rem;margin:2rem 0}nav button{background:transparent;border-color:transparent;color:#28425f;text-align:left}nav button[aria-current=page]{background:#d6e6fc;color:#134a91;border-color:#bbd3f4;font-weight:700}main{padding:2rem 3rem;min-width:0;max-width:1400px}header{display:flex;gap:1rem;align-items:center;justify-content:space-between}header button{flex-shrink:0}.muted{color:#52677f;font-size:.88rem}#error,#login-error{color:#9a2d28;overflow-wrap:anywhere}#status{color:#315775;min-height:1.5em}.counts{display:flex;flex-wrap:wrap;border-top:1px solid #cbd7e3;border-bottom:1px solid #cbd7e3;margin:1.5rem 0}.metric{padding:1rem 1.5rem 1rem 0;min-width:140px}.metric strong{display:block;font-size:1.7rem;font-variant-numeric:tabular-nums}.metric span{text-transform:capitalize;font-size:.85rem;color:#52677f}.healthy{color:#086852}.pending{color:#865300}.table-region{overflow-x:auto;border:1px solid #d2dde8;border-radius:5px;background:white;max-width:100%;margin:1rem 0}table{border-collapse:collapse;width:100%;text-align:left;font-size:.9rem}th,td{padding:.8rem;border-bottom:1px solid #dce4ec;vertical-align:top;overflow-wrap:anywhere;max-width:420px}th{background:#eaf0f6;font-weight:600}td.actions{min-width:105px}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#fff;border:1px solid #d2dde8;padding:1rem;font-size:.85rem;line-height:1.5}form.filters,form.editor{display:flex;align-items:end;gap:.8rem;flex-wrap:wrap;margin:1rem 0}form.filters>div{flex:1 1 145px}form.editor>div{flex:1 1 180px}form input,form select{width:100%}.empty{background:#fff;padding:1.5rem;border:1px solid #d2dde8}.truncated{color:#865300}.detail{border-top:2px solid #adbed0;margin-top:1.5rem}summary{cursor:pointer;font-weight:600}details p{max-width:75ch}.row-title{margin-top:2rem}.toolbar{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap}#content{min-width:0}#logout{width:100%}@media(max-width:700px){.login{margin:5vh 1rem;padding:1.5rem}#console{display:block}aside{padding:1rem;border-right:0;border-bottom:1px solid #cbd7e3}.subtitle{max-width:none;margin:.4rem 0}.brand{font-size:1.35rem}nav{display:flex;gap:.3rem;margin:.8rem 0;overflow-x:auto}nav button{padding:.55rem;font-size:.85rem;white-space:nowrap}#logout{width:auto}main{padding:1.2rem 1rem}h1{font-size:1.5rem}.metric{min-width:130px;flex:1}form.filters,form.editor{display:grid;grid-template-columns:minmax(0,1fr)}header{align-items:start}.table-region{width:100%}th,td{min-width:110px}.toolbar{align-items:stretch}}
    """
  end
  def js do
    ~S"""
    'use strict';
    (()=>{
      const $=id=>document.getElementById(id);
      let token='',view='overview',epoch=0,agents=[],filters={},pending=new Map(),mutating=false;
      const names={overview:'Overview',information:'Information',subscriptions:'Subscriptions',activity:'Activity'};
      function el(tag,text,cls){const n=document.createElement(tag);if(text!==undefined)n.textContent=String(text);if(cls)n.className=cls;return n;}
      function clear(n){n.replaceChildren();}
      function logout(){epoch++;token='';agents=[];filters={};pending.clear();mutating=false;clear($('content'));$('project').textContent='';$('checked').textContent='';$('status').textContent='';$('error').textContent='';$('token').value='';$('console').hidden=true;$('login').hidden=false;}
      async function api(command){const key=token;let response;try{response=await fetch('/admin/api',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+key},body:JSON.stringify(command),cache:'no-store',credentials:'omit'});}catch(e){throw new Error('Service could not be reached. Retry when the connection is available.');}if(key!==token)throw new Error('Session changed.');if(response.status===401){logout();$('login-error').textContent='Authentication required. Sign in again.';throw new Error('Authentication required.');}if(!response.ok)throw new Error(response.status===409?'This request conflicts with an earlier operation.':'Request could not be completed. Check the fields and retry.');return response.json();}
      function button(label,action,cls){const n=el('button',label,cls);n.type='button';n.addEventListener('click',action);return n;}
      function table(parent,label,columns,rows,render){if(!rows.length){parent.append(el('p','No matching records.','empty'));return;}const wrap=el('div',undefined,'table-region');wrap.role='region';wrap.setAttribute('aria-label',label);wrap.tabIndex=0;const t=el('table'),head=el('thead'),hr=el('tr');for(const c of columns){const th=el('th',c);th.scope='col';hr.append(th);}head.append(hr);t.append(head);const body=el('tbody');for(const row of rows){const tr=el('tr');for(const v of render(row)){const td=el('td');if(v instanceof Node)td.append(v);else td.textContent=String(v??'—');tr.append(td);}body.append(tr);}t.append(body);wrap.append(t);parent.append(wrap);}
      function truncated(parent,r){if(r.truncated)parent.append(el('p','More matching records exist. Showing the newest 50.','truncated'));}
      function input(form,label,name,type='text',value=''){const box=el('div'),id='field-'+name,n=el('input');n.id=id;n.name=name;n.type=type;n.value=value;const l=el('label',label);l.htmlFor=id;box.append(l,n);form.append(box);return n;}
      function select(form,label,name,choices){const box=el('div'),n=el('select'),l=el('label',label);n.id='field-'+name;n.name=name;l.htmlFor=n.id;for(const a of choices){const o=el('option',a);o.value=a;n.append(o);}box.append(l,n);form.append(box);return n;}
      function details(parent,p){let old=$('detail');if(old)old.remove();const panel=el('section',undefined,'detail');panel.id='detail';panel.append(el('h2','Publication details'));const pre=el('pre',JSON.stringify(p,null,2));panel.append(pre);parent.append(panel);panel.tabIndex=-1;panel.focus();}
      async function mutate(command){if(mutating)return;const fingerprint=JSON.stringify(command);if(!pending.has(fingerprint))pending.set(fingerprint,'admin-'+Array.from(crypto.getRandomValues(new Uint8Array(16)),v=>v.toString(16).padStart(2,'0')).join(''));command.message_id=pending.get(fingerprint);mutating=true;const buttons=[...$('content').querySelectorAll('button')];buttons.forEach(b=>b.disabled=true);$('error').textContent='';const version=epoch;try{await api(command);pending.delete(fingerprint);if(version===epoch){$('status').textContent='Change saved.';await load();}}catch(e){if(version===epoch)$('error').textContent=e.message+' Retrying this action preserves its request ID.';}finally{mutating=false;buttons.forEach(b=>b.disabled=false);}}
      function guide(parent){const d=el('details');d.append(el('summary','Operator guide and limits'));const text=[
        'This version supports one running process per DETS store. Stop the service before making an offline backup; copy the complete store and keep its private configuration separately. Never replace a corrupt store. Schema-1 and schema-2 upgrades preserve accepted information and receipts. Use a pre-upgrade offline backup for rollback.',
        'Provision distinct random agent tokens of at least 24 characters and a separate administrator token of at least 32 bytes in the private configuration. Rotate by editing configuration and restarting the service; share each token only with its intended holder. Do not publish credentials or add them to tunnel URLs. The console keeps its token in memory until logout or reload.',
        'Access the loopback service through an authenticated private tunnel or proxy. Configure public_url for that endpoint and preserve Authorization and Origin headers. The administrator credential grants management access only; agent and peer credentials are separate.',
        'Information is project-wide published history. Addressed message bodies are private to their recipient and are never shown in management, information search or federation. Management observes only delivery metadata. Only explicitly allowlisted publications and the approved project description are exportable federation evidence.',
        'Subscriptions apply to future publications. Removing one cancels pending evaluations without withdrawing deliveries. Confirm retry to make pending jobs eligible immediately; completed work and acknowledgements remain unchanged. Lists show the newest 50 rows and identify truncation.',
        'Refresh checks the active view. Service reachable and matcher health are separate signals; a healthy probe does not guarantee a classification. During matcher outages local publish, search and polling remain available. Check the matcher service and private network, then retry pending work. Authentication errors require signing in again.'
      ];for(const p of text)d.append(el('p',p));parent.append(d);}
      function overview(parent,r){$('project').textContent=r.project_id;agents=r.agents.map(a=>a.agent_id);parent.append(el('p','Service reachable','healthy'));const metrics=el('div',undefined,'counts');for(const [k,v]of Object.entries(r.counts)){const m=el('div',undefined,'metric');m.append(el('strong',v),el('span',k.replaceAll('_',' ')));metrics.append(m);}parent.append(metrics);parent.append(el('h2','Matcher health'));parent.append(el('p',r.matcher.status==='ready'?'Ready':'Unavailable',r.matcher.status==='ready'?'healthy':'pending'));parent.append(el('p','Model: '+r.matcher.model+' · Observed '+r.matcher.checked_at,'muted'));table(parent,'Agent totals',['Agent','Subscriptions','Queued deliveries'],r.agents,a=>[a.agent_id,a.subscriptions,a.queued_deliveries]);guide(parent);}
      function information(parent,r){const form=el('form',undefined,'filters');const fs={};for(const [key,label] of [['query','Search text'],['information_type','Information type'],['source_kind','Source kind'],['source_id','Source ID']])fs[key]=input(form,label,key,'text',filters[key]||'');const submit=el('button','Search');submit.type='submit';form.append(submit);form.addEventListener('submit',e=>{e.preventDefault();filters={};for(const [k,n]of Object.entries(fs))if(n.value.trim())filters[k]=n.value;load();});parent.append(form);table(parent,'Published information',['Type / source','Text','Accepted','Details'],r.items,p=>[p.information_type+' · '+p.source.kind+': '+p.source.id,p.text||'(structured data)',p.created_at,button('View details',async()=>{const version=epoch;try{const result=await api({op:'publication',publication_id:p.id});if(version===epoch)details(parent,result.publication);}catch(e){if(version===epoch)$('error').textContent=e.message;}})]);truncated(parent,r);}
      function subscriptions(parent,r){const form=el('form',undefined,'editor');const a=select(form,'Owner agent','owner',agents);const d=input(form,'Subscription description','description');d.required=true;d.maxLength=4096;const submit=el('button','Create subscription');submit.type='submit';form.append(submit);form.addEventListener('submit',e=>{e.preventDefault();if(d.value.trim())mutate({op:'create_subscription',agent_id:a.value,description:d.value});});parent.append(form);table(parent,'Subscriptions',['Owner','Description','Created','Action'],r.items,s=>[s.agent_id,s.description,s.created_at,button('Remove',()=>{if(confirm('Remove subscription owned by '+s.agent_id+'?\n\n'+s.description))mutate({op:'remove_subscription',subscription_id:s.id,confirm:true});},'danger')]);truncated(parent,r);}
      function activity(parent,deliveries,jobs){const bar=el('div',undefined,'toolbar');bar.append(el('p','Delivery metadata only. Private addressed content is hidden.'));bar.append(button('Retry pending jobs',()=>{if(confirm('Retry all pending matching jobs? Completed jobs and acknowledgements will remain unchanged.'))mutate({op:'retry_jobs',confirm:true});},'secondary'));parent.append(bar,el('h2','Deliveries'));table(parent,'Delivery metadata',['Delivery','Recipient','Kind','Created','Acknowledged','Publication'],deliveries.items,d=>[d.delivery_id,d.recipient_id,d.kind,d.created_at,d.acknowledged?'Yes':'No',d.publication_id||'—']);truncated(parent,deliveries);parent.append(el('h2','Matching jobs'));table(parent,'Matching jobs',['Job','Publication','Subscription','Recipient','Status','Retry time'],jobs.items,j=>[j.job_id,j.publication_id,j.subscription_id,j.recipient_id,j.status,j.retry_at===0?'Eligible now':new Date(j.retry_at).toISOString()]);truncated(parent,jobs);}
      async function load(){const version=++epoch;const active=view;$('heading').textContent=names[view];$('status').textContent='Loading…';$('error').textContent='';clear($('content'));document.querySelectorAll('[data-view]').forEach(n=>{if(n.dataset.view===view)n.setAttribute('aria-current','page');else n.removeAttribute('aria-current');});try{let render;if(active==='overview'){const r=await api({op:'overview'});render=p=>overview(p,r);}else if(active==='information'){const r=await api({op:'publications',...filters});render=p=>information(p,r);}else if(active==='subscriptions'){const [r,o]=await Promise.all([api({op:'subscriptions'}),api({op:'overview'})]);render=p=>{agents=o.agents.map(a=>a.agent_id);subscriptions(p,r);};}else{const [d,j]=await Promise.all([api({op:'deliveries'}),api({op:'jobs'})]);render=p=>activity(p,d,j);}if(version!==epoch)return;render($('content'));$('status').textContent='Ready';$('checked').textContent='Last checked '+new Date().toLocaleString();}catch(e){if(version===epoch){$('error').textContent=e.message;$('status').textContent='Could not load this view. Use Refresh to retry.';}}}
      $('login-form').addEventListener('submit',async e=>{e.preventDefault();if(! $('token').value)return;token=$('token').value;$('token').value='';$('login-error').textContent='';const submit=e.submitter;submit.disabled=true;try{const r=await api({op:'overview'});agents=r.agents.map(a=>a.agent_id);$('login').hidden=true;$('console').hidden=false;view='overview';await load();}catch(e){if(token){logout();$('login-error').textContent=e.message;}}finally{submit.disabled=false;}});
      $('logout').addEventListener('click',logout);$('refresh').addEventListener('click',()=>load());document.querySelectorAll('[data-view]').forEach(n=>n.addEventListener('click',()=>{view=n.dataset.view;load();}));
    })();
    """
  end
end
