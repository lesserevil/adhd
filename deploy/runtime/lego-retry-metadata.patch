+package cmd
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"github.com/go-acme/lego/v5/cmd/internal"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestACMEResultClosedProtocol(t *testing.T) {
+	now := time.UnixMilli(1700000000000)
+	for _, c := range []struct {
+		err  error
+		want string
+	}{
+		{errors.New("secret=https://account/private"), `ADHD_ACME_RESULT {"code":"ACME_PROCESS","retry_at":null}` + "\n"},
+		{fmt.Errorf("private wrapper: %w", internal.NewACMERateLimitError(errors.New("secret"), "120", now)), `ADHD_ACME_RESULT {"code":"ACME_RATE_LIMIT","retry_at":1700000120000}` + "\n"},
+		{internal.NewACMERateLimitError(errors.New("secret"), "bad", now), `ADHD_ACME_RESULT {"code":"ACME_RATE_LIMIT","retry_at":null}` + "\n"},
+	} {
+		var out bytes.Buffer
+		WriteACMEResult(c.err, &out)
+		if out.String() != c.want || len(out.Bytes()) > 128 || strings.Contains(out.String(), "secret") {
+			t.Fatal("unsafe process metadata")
+		}
+	}
+}
