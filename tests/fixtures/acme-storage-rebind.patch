+defmodule ADHD.ACMERebind do
+  # Metadata-only extension of the existing offline transaction. No account,
+  # certificate, key or lifecycle-state content is rewritten or initialized.
+  alias ADHD.RecoveryFiles, as: F
+  @maximum 1073741824
+  @records 1000000
+  def capture(path,old,uid,limits) do
+    root=root(path);witness=path<>".acme-owner.json"
+    if absent?(root) and absent?(witness) do
+      {%{"initialized"=>false},[]}
+    else
+      F.private(root,:directory,uid)
+      check(absent?(Path.join(root,"client.lock")) or ADHD.ACMEClient.lock_available?(root))
+      {wb,_}=F.read(witness,4096,uid);w=F.json(wb)
+      F.keys(w,~w(config_path owner phase))
+      check(w["config_path"]==ADHD.Domain.digest(Path.expand(old)) and w["phase"]=="ready")
+      check(is_binary(w["owner"]) and Regex.match?(~r/\A[A-Za-z0-9_-]{32}\z/,w["owner"]))
+      {ob,_}=F.read(Path.join(root,"owner.json"),4096,uid)
+      check(F.json(ob)==Map.delete(w,"phase"))
+      # Missing initialized state or any required private subtree is an error,
+      # never an invitation to create a fresh account/certificate store.
+      for name<-~w(accounts attempts generations),do: F.private(Path.join(root,name),:directory,uid)
+      F.read(Path.join(root,"state.json"),2097152,uid)
+      deadline=limits["deadline_ms"]
+      max_bytes=min(limits["max_backup_bytes"],@maximum)
+      max_records=min(Map.get(limits,"max_records",@records),@records)
+      {files,dirs,_}=walk(root,"",uid,deadline,max_bytes,max_records,{[],[],0})
+      proof=%{"initialized"=>true,"old_config_path"=>w["config_path"],"owner"=>w["owner"],"files"=>Enum.sort_by(files,& &1["path"]),"directories"=>Enum.sort(dirs),"maximum_bytes"=>max_bytes}
+      validate(proof,path)
+      nw=Map.put(w,"config_path",ADHD.Domain.digest(Path.expand(path)))
+      {proof,[{"acme-witness",witness,wb,nw},{"acme-owner",Path.join(root,"owner.json"),ob,Map.delete(nw,"phase")}]}
+    end
+  end
+  def validate(%{"initialized"=>false}=p,_path),do: F.keys(p,["initialized"])
+  def validate(p,_path) do
+    F.keys(p,~w(initialized old_config_path owner files directories maximum_bytes))
+    check(p["initialized"]==true)
+    F.hex(p["old_config_path"],64)
+    check(is_binary(p["owner"]) and Regex.match?(~r/\A[A-Za-z0-9_-]{32}\z/,p["owner"]))
+    F.integer(p["maximum_bytes"],1,@maximum)
+    check(is_list(p["files"]) and is_list(p["directories"]) and length(p["files"])+length(p["directories"])<=@records)
+    for f<-p["files"] do
+      F.keys(f,~w(path bytes sha256));relative(f["path"]);F.integer(f["bytes"],0,p["maximum_bytes"]);F.hex(f["sha256"],64)
+      check(f["path"]!="owner.json")
+    end
+    for d<-p["directories"],do: relative(d)
+    check(Enum.map(p["files"],& &1["path"])==Enum.sort(Enum.uniq(Enum.map(p["files"],& &1["path"]))))
+    check(p["directories"]==Enum.sort(Enum.uniq(p["directories"])))
+    check(Enum.all?(~w(accounts attempts generations),&(&1 in p["directories"])))
+    check(Enum.any?(p["files"],&(&1["path"]=="state.json")))
+    check(Enum.sum(Enum.map(p["files"],& &1["bytes"]))<=p["maximum_bytes"])
+    :ok
+  end
+  def verify(%{"initialized"=>false},path,_uid,_decided) do
+    check(absent?(root(path)) and absent?(path<>".acme-owner.json"))
+  end
+  def verify(p,path,uid,decided) do
+    validate(p,path);root=root(path)
+    F.private(root,:directory,uid)
+    check(absent?(Path.join(root,"client.lock")) or ADHD.ACMEClient.lock_available?(root))
+    {wb,_}=F.read(path<>".acme-owner.json",4096,uid)
+    {ob,_}=F.read(Path.join(root,"owner.json"),4096,uid)
+    old=%{"owner"=>p["owner"],"config_path"=>p["old_config_path"]}
+    new=Map.put(old,"config_path",ADHD.Domain.digest(Path.expand(path)))
+    choices=if decided,do: [old,new],else: [old]
+    check(F.json(ob) in choices)
+    check(F.json(wb) in Enum.map(choices,&Map.put(&1,"phase","ready")))
+    {files,dirs,_}=walk(root,"",uid,System.monotonic_time(:millisecond)+300000,p["maximum_bytes"],@records,{[],[],0})
+    check(Enum.sort_by(files,& &1["path"])==p["files"] and Enum.sort(dirs)==p["directories"])
+    :ok
+  end
+  defp walk(root,relative,uid,deadline,max_bytes,max_records,{files,dirs,total}) do
+    check(System.monotonic_time(:millisecond)<deadline)
+    path=if relative=="",do: root,else: Path.join(root,relative)
+    before=F.private(path,:directory,uid)
+    names=File.ls!(path)|>Enum.sort()
+    check(length(names)+length(files)+length(dirs)<=max_records)
+    result=Enum.reduce(names,{files,dirs,total},fn name,{fs,ds,n}->
+      check(name not in [".",".."] and not String.contains?(name,["/",<<0>>]))
+      r=if relative=="",do: name,else: relative<>"/"<>name
+      child=Path.join(root,r)
+      case File.lstat!(child).type do
+        :directory->walk(root,r,uid,deadline,max_bytes,max_records,{fs,[r|ds],n})
+        :regular->
+          check(System.monotonic_time(:millisecond)<deadline)
+          {bytes,_}=F.read(child,max_bytes-n,uid)
+          if r=="owner.json",do: {fs,ds,n},else: {[%{"path"=>r,"bytes"=>byte_size(bytes),"sha256"=>F.sha(bytes)}|fs],ds,n+byte_size(bytes)}
+        _->check(false)
+      end
+    end)
+    check(Enum.sort(File.ls!(path))==names)
+    check(F.identity(F.private(path,:directory,uid))==F.identity(before))
+    result
+  end
+  defp relative(p) do
+    check(is_binary(p) and byte_size(p)>0 and byte_size(p)<=4096 and Path.type(p)==:relative and Path.join(Path.split(p))==p and not Enum.any?(Path.split(p),&(&1 in [".",".."])) and not String.contains?(p,<<0>>))
+  end
+  defp root(path),do: Path.join(Path.dirname(Path.expand(path)),"acme")
+  defp absent?(path),do: match?({:error,:enoent},File.lstat(path))
+  defp check(true),do: :ok
+  defp check(_),do: ADHD.Domain.fail("RESTORE_CONFLICT")
+end
