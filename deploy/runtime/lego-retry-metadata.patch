+// ADHD integration: preserve issuer retry metadata without serializing CA details.
+// The underlying maintained client's request/retry/validation behavior is unchanged.
+package internal
+
+import (
+	"math"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type ACMERateLimitError struct {
+	Cause   error
+	RetryAt *int64
+}
+
+func (e *ACMERateLimitError) Error() string { return e.Cause.Error() }
+func (e *ACMERateLimitError) Unwrap() error { return e.Cause }
+func NewACMERateLimitError(cause error, header string, observed time.Time) *ACMERateLimitError {
+	result := &ACMERateLimitError{Cause: cause}
+	header = strings.TrimSpace(header)
+	if header == "" {
+		return result
+	}
+	digits := true
+	for _, v := range header {
+		if v < '0' || v > '9' {
+			digits = false
+			break
+		}
+	}
+	now := observed.UnixMilli()
+	if digits {
+		seconds, err := strconv.ParseUint(header, 10, 64)
+		if err != nil || now < 0 || seconds > uint64((math.MaxInt64-now)/1000) {
+			return result
+		}
+		at := now + int64(seconds)*1000
+		result.RetryAt = &at
+		return result
+	}
+	date, err := http.ParseTime(header)
+	if err != nil {
+		return result
+	}
+	at := date.UnixMilli()
+	if at < now {
+		at = now
+	}
+	result.RetryAt = &at
+	return result
+}
