+package internal
+
+import (
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestACMERetryMetadata(t *testing.T) {
+	now := time.Date(2026, 10, 22, 12, 0, 0, 0, time.UTC)
+	for _, c := range []struct {
+		header string
+		known  bool
+		delta  int64
+	}{
+		{"120", true, 120000}, {"0", true, 0}, {"Thu, 22 Oct 2026 12:02:00 GMT", true, 120000},
+		{"Thu, 22 Oct 2026 11:02:00 GMT", true, 0}, {"", false, 0}, {"bad", false, 0},
+		{"-1", false, 0}, {"+1", false, 0}, {"18446744073709551615", false, 0},
+	} {
+		value := NewACMERateLimitError(errors.New("private CA detail"), c.header, now)
+		if (value.RetryAt != nil) != c.known {
+			t.Fatalf("header %q known", c.header)
+		}
+		if c.known && *value.RetryAt != now.UnixMilli()+c.delta {
+			t.Fatalf("header %q value", c.header)
+		}
+	}
+}
+
+type ACMEFinal429Transport struct{ Calls int }
+
+func (f *ACMEFinal429Transport) RoundTrip(request *http.Request) (*http.Response, error) {
+	f.Calls++
+	header := "0"
+	if f.Calls == 6 {
+		header = "120"
+	}
+	return &http.Response{StatusCode: 429, Header: http.Header{"Retry-After": []string{header}},
+		Body:    io.NopCloser(strings.NewReader(`{"type":"urn:ietf:params:acme:error:rateLimited","status":429,"detail":"private"}`)),
+		Request: request}, nil
+}
+func TestACMEFinalExhausted429PreservesLastHeader(t *testing.T) {
+	transport := &ACMEFinal429Transport{}
+	client := NewRetryableClient(&http.Client{Transport: transport})
+	before := time.Now().UnixMilli()
+	_, err := client.Get("https://no-network.invalid/directory")
+	var metadata *ACMERateLimitError
+	if transport.Calls != 6 || !errors.As(err, &metadata) || metadata.RetryAt == nil {
+		t.Fatal("final retry metadata lost")
+	}
+	if *metadata.RetryAt < before+120000 || *metadata.RetryAt > time.Now().UnixMilli()+120000 {
+		t.Fatal("wrong final delay")
+	}
+}
