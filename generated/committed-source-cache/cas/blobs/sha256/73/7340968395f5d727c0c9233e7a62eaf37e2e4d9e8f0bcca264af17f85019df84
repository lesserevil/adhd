    paused=s |> put_in([:optimization,"proposals",parent["id"]],parent) |> put_in([:replay_queries,"native-opt-pair"],pair)
    equal(O.history_allowed?(paused,c,%{"id"=>"native-opt-history","run"=>1}),false)
