defmodule Hub.Assets do
  def html do
    ~S"""
    <!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>ADHD | Agentic Distributed Harness Depot</title><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231b3655'/%3E%3Ctext x='8' y='24' fill='white' font-size='24'%3EA%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/admin/assets/app.css"><script defer src="/admin/assets/app.js"></script></head><body><section id="login" class="login"><p class="eyebrow">ADHD · Private operations</p><h1>Agentic Distributed Harness Depot</h1><p>Sign in to manage project information and subscriptions.</p><form id="login-form"><label for="token">Administrator token</label><input id="token" type="password" autocomplete="off" required><button type="submit">Sign in</button></form><p id="login-error" role="alert"></p></section><div id="console" hidden><aside><div class="brand">ADHD</div><p class="subtitle">Agentic Distributed Harness Depot</p><nav aria-label="Main navigation"><button data-view="overview" aria-current="page">Overview</button><button data-view="information">Information</button><button data-view="subscriptions">Subscriptions</button><button data-view="activity">Activity</button></nav><button id="logout" class="secondary">Log out</button></aside><main><header><div><p id="project" class="eyebrow"></p><h1 id="heading">Overview</h1></div><button id="refresh" class="secondary">Refresh</button></header><p id="status" role="status" aria-live="polite"></p><p id="error" role="alert"></p><div id="content"></div><p id="checked" class="muted"></p></main></div></body></html>
