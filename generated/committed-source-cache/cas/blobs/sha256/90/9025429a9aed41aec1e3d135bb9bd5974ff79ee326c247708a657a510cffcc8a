    {id, s} = alloc(s, "delivery")

    d = %{
      "id" => id,
      "project_id" => c["project_id"],
      "recipient_id" => recipient,
      "sender_id" => a,
      "kind" => "message",
      "text" => Map.get(cmd, "text", ""),
      "data" => Map.get(cmd, "data", %{}),
      "created_at" => D.now()
    }

    {%{"delivery" => d}, put_in(s, [:deliveries, id], %{seq: s.seq, value: d, ack: false})}
  end

