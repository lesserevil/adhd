+package internal
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func retryTestPath(t *testing.T) string {
+	t.Helper()
+	directory := t.TempDir()
+	if err := os.Chmod(directory, 0700); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(directory, "issuer-retry.json")
+	t.Setenv("ADHD_ACME_RETRY_FILE", path)
+	return path
+}
+func TestACMEDurableFloorBeforeBackoff(t *testing.T) {
+	path := retryTestPath(t)
+	now := time.Now().UnixMilli()
+	response := &http.Response{StatusCode: 429, Header: http.Header{"Retry-After": []string{"120"}}, Body: io.NopCloser(strings.NewReader(`{"type":"urn:ietf:params:acme:error:rateLimited","status":429}`)), Request: &http.Request{Method: "GET"}}
+	retry, err := checkRetry(context.Background(), response, nil)
+	if !retry || err == nil {
+		t.Fatal("maintained retry semantics")
+	}
+	data, e := os.ReadFile(path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	record, e := decodeACMERetry(data)
+	if e != nil || record.RetryAt == nil || *record.RetryAt < now+120000 {
+		t.Fatal("floor not durable before retry decision")
+	}
+	stat, e := os.Stat(path)
+	if e != nil || stat.Mode().Perm() != 0600 {
+		t.Fatal("private floor")
+	}
+	earlier := now + 1000
+	got, e := StoreACMERetry(ACMERetryRecord{Code: "ACME_PROCESS", RetryAt: &earlier})
+	if e != nil || got.RetryAt == nil || *got.RetryAt != *record.RetryAt {
+		t.Fatal("earlier response overwrote issuer floor")
+	}
+	got, e = StoreACMERetry(ACMERetryRecord{Code: "ACME_RATE_LIMIT"})
+	if e != nil || got.RetryAt == nil || *got.RetryAt != *record.RetryAt {
+		t.Fatal("unknown response overwrote issuer floor")
+	}
+	entries, e := os.ReadDir(filepath.Dir(path))
+	if e != nil || len(entries) != 1 {
+		t.Fatal("temporary file leak")
+	}
+}
+func TestACMERetryPersistenceFailureStopsRetry(t *testing.T) {
+	path := retryTestPath(t)
+	if err := os.Symlink("missing", path); err != nil {
+		t.Fatal(err)
+	}
+	response := &http.Response{StatusCode: 503, Header: http.Header{"Retry-After": []string{"120"}}, Body: io.NopCloser(strings.NewReader("private"))}
+	retry, err := checkRetry(context.Background(), response, nil)
+	if retry || err == nil {
+		t.Fatal("unsafe persistence must stop retry")
+	}
+	if target, e := os.Readlink(path); e != nil || target != "missing" {
+		t.Fatal("unsafe input changed")
+	}
+}
+func TestACMERetryFileClosedSchema(t *testing.T) {
+	for _, data := range []string{`{"code":"ACME_PROCESS","retry_at":null,"extra":1}`, `{"code":"ACME_PROCESS","code":"ACME_PROCESS","retry_at":null}`, `{"code":"ACME_PROCESS","retry_at":true}`, `{"code":"ACME_PROCESS","retry_at":1.5}`, `{"code":"ACME_PROCESS","retry_at":-1}`, `{"code":"ACME_PROCESS","retry_at":null} {}`} {
+		if _, err := decodeACMERetry([]byte(data)); err == nil {
+			t.Fatal("accepted open schema")
+		}
+	}
+	path := retryTestPath(t)
+	if err := os.WriteFile(path, []byte(`{"code":"ACME_PROCESS","retry_at":null}`), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := PreflightACMERetryFile(); err == nil {
+		t.Fatal("accepted nonprivate file")
+	}
+}
