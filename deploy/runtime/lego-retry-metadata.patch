+// ADHD's app-owned durable issuer floor. The guardian provides single-writer locking.
+package internal
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strconv"
+	"syscall"
+)
+
+type ACMERetryRecord struct {
+	Code    string `json:"code"`
+	RetryAt *int64 `json:"retry_at"`
+}
+
+func EmitACMERetry(record ACMERetryRecord, writer io.Writer) {
+	payload, err := json.Marshal(record)
+	if err == nil {
+		_, _ = io.WriteString(writer, "ADHD_ACME_RESULT "+string(payload)+"\n")
+	}
+}
+func retryDirectory() (int, error) {
+	path := os.Getenv("ADHD_ACME_RETRY_FILE")
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path || filepath.Base(path) != "issuer-retry.json" {
+		return -1, errors.New("invalid private retry path")
+	}
+	directory, err := syscall.Open("/", syscall.O_RDONLY|syscall.O_DIRECTORY|syscall.O_CLOEXEC, 0)
+	if err != nil {
+		return -1, err
+	}
+	parent := filepath.Dir(path)
+	if parent != "/" {
+		parts := splitRetryPath(parent)
+		for _, part := range parts {
+			next, e := syscall.Openat(directory, part, syscall.O_RDONLY|syscall.O_DIRECTORY|syscall.O_NOFOLLOW|syscall.O_CLOEXEC, 0)
+			syscall.Close(directory)
+			if e != nil {
+				return -1, e
+			}
+			directory = next
+		}
+	}
+	var stat syscall.Stat_t
+	if syscall.Fstat(directory, &stat) != nil || stat.Uid != uint32(os.Geteuid()) || stat.Mode&0077 != 0 {
+		syscall.Close(directory)
+		return -1, errors.New("unsafe retry directory")
+	}
+	return directory, nil
+}
+func splitRetryPath(path string) []string {
+	var out []string
+	for path != "/" && path != "." {
+		parent, part := filepath.Split(path)
+		if part != "" {
+			out = append([]string{part}, out...)
+		}
+		path = filepath.Clean(parent)
+	}
+	return out
+}
+func readACMERetry(directory int) (*ACMERetryRecord, error) {
+	fd, err := syscall.Openat(directory, "issuer-retry.json", syscall.O_RDONLY|syscall.O_NONBLOCK|syscall.O_NOFOLLOW|syscall.O_CLOEXEC, 0)
+	if err == syscall.ENOENT {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	file := os.NewFile(uintptr(fd), "issuer-retry.json")
+	defer file.Close()
+	var stat syscall.Stat_t
+	if syscall.Fstat(fd, &stat) != nil || stat.Mode&syscall.S_IFMT != syscall.S_IFREG || stat.Uid != uint32(os.Geteuid()) || stat.Nlink != 1 || stat.Mode&07777 != 0600 || stat.Size > 256 {
+		return nil, errors.New("unsafe retry file")
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 257))
+	if err != nil || len(data) > 256 {
+		return nil, errors.New("invalid retry file")
+	}
+	return decodeACMERetry(data)
+}
+func decodeACMERetry(data []byte) (*ACMERetryRecord, error) {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	token, err := decoder.Token()
+	if err != nil || token != json.Delim('{') {
+		return nil, errors.New("invalid retry object")
+	}
+	values := map[string]any{}
+	for decoder.More() {
+		key, e := decoder.Token()
+		if e != nil {
+			return nil, e
+		}
+		name, ok := key.(string)
+		if !ok {
+			return nil, errors.New("retry key")
+		}
+		if _, exists := values[name]; exists {
+			return nil, errors.New("duplicate retry key")
+		}
+		var value any
+		if e = decoder.Decode(&value); e != nil {
+			return nil, e
+		}
+		values[name] = value
+	}
+	if _, err = decoder.Token(); err != nil {
+		return nil, err
+	}
+	if _, err = decoder.Token(); err != io.EOF {
+		return nil, errors.New("trailing retry data")
+	}
+	if len(values) != 2 {
+		return nil, errors.New("retry fields")
+	}
+	code, ok := values["code"].(string)
+	if !ok || (code != "ACME_RATE_LIMIT" && code != "ACME_PROCESS") {
+		return nil, errors.New("retry code")
+	}
+	raw, exists := values["retry_at"]
+	if !exists {
+		return nil, errors.New("retry time")
+	}
+	result := &ACMERetryRecord{Code: code}
+	if raw != nil {
+		number, ok := raw.(json.Number)
+		if !ok {
+			return nil, errors.New("retry integer")
+		}
+		at, e := strconv.ParseInt(string(number), 10, 64)
+		if e != nil || at < 0 {
+			return nil, errors.New("retry integer")
+		}
+		result.RetryAt = &at
+	}
+	return result, nil
+}
+func PreflightACMERetryFile() error {
+	directory, err := retryDirectory()
+	if err != nil {
+		return err
+	}
+	defer syscall.Close(directory)
+	if _, err = readACMERetry(directory); err != nil {
+		return err
+	}
+	return syscall.Fsync(directory)
+}
+func StoreACMERetry(record ACMERetryRecord) (ACMERetryRecord, error) {
+	directory, err := retryDirectory()
+	if err != nil {
+		return record, err
+	}
+	defer syscall.Close(directory)
+	old, err := readACMERetry(directory)
+	if err != nil {
+		return record, err
+	}
+	if old != nil && old.RetryAt != nil && (record.RetryAt == nil || *old.RetryAt > *record.RetryAt) {
+		record.RetryAt = old.RetryAt
+	}
+	payload, err := json.Marshal(record)
+	if err != nil {
+		return record, err
+	}
+	var random [12]byte
+	if _, err = rand.Read(random[:]); err != nil {
+		return record, err
+	}
+	temp := fmt.Sprintf(".issuer-retry-%x.tmp", random[:])
+	fd, err := syscall.Openat(directory, temp, syscall.O_WRONLY|syscall.O_CREAT|syscall.O_EXCL|syscall.O_NOFOLLOW|syscall.O_CLOEXEC, 0600)
+	if err != nil {
+		return record, err
+	}
+	file := os.NewFile(uintptr(fd), temp)
+	defer func() { file.Close(); syscall.Unlinkat(directory, temp) }()
+	if _, err = file.Write(payload); err != nil {
+		return record, err
+	}
+	if err = file.Sync(); err != nil {
+		return record, err
+	}
+	if err = file.Close(); err != nil {
+		return record, err
+	}
+	if err = syscall.Renameat(directory, temp, directory, "issuer-retry.json"); err != nil {
+		return record, err
+	}
+	if err = syscall.Fsync(directory); err != nil {
+		return record, err
+	}
+	return record, nil
+}
